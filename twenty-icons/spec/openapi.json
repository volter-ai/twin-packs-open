{
  "openapi": "3.0.3",
  "info": {
    "title": "Twenty favicon provider (twenty-icons.com)",
    "version": "fb84fc14394ee60a675fa88a892b912cb4329557",
    "description": "Written from the vendor's open-source service at the commit named as the version (src/favicon/favicon.controller.ts, src/favicon/utils/domain.ts, src/favicon/favicon.constants.ts) and from its host's answers; the vendor publishes no API document (spec/SOURCE.md)."
  },
  "servers": [
    {
      "url": "https://twenty-icons.com"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getRoot",
        "description": "Redirect to the service's README.",
        "responses": {
          "301": {
            "description": "A permanent redirect to the README on GitHub",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/{domainName}": {
      "get": {
        "operationId": "getFavicon",
        "description": "Return the domain's favicon as a PNG at the highest available supported size.",
        "parameters": [
          {
            "name": "domainName",
            "in": "path",
            "required": true,
            "description": "A lowercase domain name, without scheme or path.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The favicon",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid domain",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Could not fetch favicon",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/{domainName}/{size}": {
      "get": {
        "operationId": "getFaviconWithSize",
        "description": "Return the domain's favicon as a PNG at the requested supported size, or the largest smaller one stored.",
        "parameters": [
          {
            "name": "domainName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "enum": [16, 32, 64, 128, 180, 192]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The favicon",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid domain or Invalid size",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Could not fetch favicon",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "checkHealth",
        "description": "Answer 200 with an empty body.",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "checkHealthz",
        "description": "Answer 200 with an empty body.",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    }
  }
}
