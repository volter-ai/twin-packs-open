{
  "name": "insert-duplicate-id",
  "why": "an ordered insert of three documents whose second repeats an _id already there: what is written, what is refused, and what the third does",
  "oracle": "mongod 7.0.16 standalone",
  "setup": [
    {
      "insert": "people",
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "name": "Ada"
        }
      ]
    }
  ],
  "ask": {
    "insert": "people",
    "documents": [
      {
        "_id": {
          "$numberInt": "2"
        },
        "name": "Grace"
      },
      {
        "_id": {
          "$numberInt": "1"
        },
        "name": "Again"
      },
      {
        "_id": {
          "$numberInt": "3"
        },
        "name": "Edsger"
      }
    ],
    "ordered": true
  },
  "answer": {
    "n": {
      "$numberInt": "1"
    },
    "writeErrors": [
      {
        "index": {
          "$numberInt": "1"
        },
        "code": {
          "$numberInt": "11000"
        },
        "errmsg": "E11000 duplicate key error collection: ask_insert_duplicate_id.people index: _id_ dup key: { _id: 1 }",
        "keyPattern": {
          "_id": {
            "$numberInt": "1"
          }
        },
        "keyValue": {
          "_id": {
            "$numberInt": "1"
          }
        }
      }
    ],
    "ok": {
      "$numberDouble": "1.0"
    }
  },
  "state": {
    "people": {
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "name": "Ada"
        },
        {
          "_id": {
            "$numberInt": "2"
          },
          "name": "Grace"
        }
      ],
      "indexes": [
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "_id": {
              "$numberInt": "1"
            }
          },
          "name": "_id_"
        }
      ]
    }
  }
}
