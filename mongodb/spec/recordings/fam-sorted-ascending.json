{
  "name": "fam-sorted-ascending",
  "why": "a findAndModify whose query matches three documents and whose sort is a date ascending: which ONE it changes and returns (the scheduler's lease: LibreChat's [schedules] tick)",
  "oracle": "mongod 7.0.16 standalone",
  "setup": [
    {
      "insert": "things",
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "k": "a",
          "at": {
            "$date": {
              "$numberLong": "1700000300000"
            }
          }
        },
        {
          "_id": {
            "$numberInt": "2"
          },
          "k": "a",
          "at": {
            "$date": {
              "$numberLong": "1700000100000"
            }
          }
        },
        {
          "_id": {
            "$numberInt": "3"
          },
          "k": "a",
          "at": {
            "$date": {
              "$numberLong": "1700000200000"
            }
          }
        },
        {
          "_id": {
            "$numberInt": "4"
          },
          "k": "b",
          "at": {
            "$date": {
              "$numberLong": "1700000000000"
            }
          }
        }
      ]
    }
  ],
  "ask": {
    "findAndModify": "things",
    "query": {
      "k": "a"
    },
    "remove": false,
    "new": true,
    "upsert": false,
    "sort": {
      "at": {
        "$numberInt": "1"
      }
    },
    "update": {
      "$set": {
        "taken": true
      }
    }
  },
  "answer": {
    "lastErrorObject": {
      "n": {
        "$numberInt": "1"
      },
      "updatedExisting": true
    },
    "value": {
      "_id": {
        "$numberInt": "2"
      },
      "k": "a",
      "at": {
        "$date": {
          "$numberLong": "1700000100000"
        }
      },
      "taken": true
    },
    "ok": {
      "$numberDouble": "1.0"
    }
  },
  "state": {
    "things": {
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "k": "a",
          "at": {
            "$date": {
              "$numberLong": "1700000300000"
            }
          }
        },
        {
          "_id": {
            "$numberInt": "2"
          },
          "k": "a",
          "at": {
            "$date": {
              "$numberLong": "1700000100000"
            }
          },
          "taken": true
        },
        {
          "_id": {
            "$numberInt": "3"
          },
          "k": "a",
          "at": {
            "$date": {
              "$numberLong": "1700000200000"
            }
          }
        },
        {
          "_id": {
            "$numberInt": "4"
          },
          "k": "b",
          "at": {
            "$date": {
              "$numberLong": "1700000000000"
            }
          }
        }
      ],
      "indexes": [
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "_id": {
              "$numberInt": "1"
            }
          },
          "name": "_id_"
        }
      ]
    }
  }
}
