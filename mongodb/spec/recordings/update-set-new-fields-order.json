      "$numberInt": "1"
    },
    "ok": {
      "$numberDouble": "1.0"
    }
  },
  "state": {
    "things": {
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "m": "new",
          "b": "keep",
          "alpha": {
            "$numberInt": "2"
          },
          "kappa": {
            "$numberInt": "3"
          },
          "zeta": {
            "$numberInt": "1"
          }
        }
      ],
      "indexes": [
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "_id": {
              "$numberInt": "1"
            }
          },
          "name": "_id_"
        }
      ]
    }
  }
}
