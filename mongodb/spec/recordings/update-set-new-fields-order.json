      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "m": "old",
          "b": "keep"
        }
      ]
    }
  ],
  "ask": {
    "update": "things",
    "updates": [
      {
        "q": {
          "_id": {
            "$numberInt": "1"
          }
