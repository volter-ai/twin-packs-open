          ]
        },
        {
          "_id": {
            "$numberInt": "5"
          },
          "k": "c"
        }
      ]
    }
  ],
  "ask": {
    "find": "things",
    "filter": {},
    "lsid": {
      "id": {
        "$binary": {
          "base64": "AAAAAAAAQACAAAAAAAAAAA==",
          "subType": "04"
        }
      }
    },
    "txnNumber": {
      "$numberLong": "1"
    },
    "startTransaction": true,
    "autocommit": false
  },
  "answer": {
    "ok": {
      "$numberDouble": "0.0"
    },
    "errmsg": "Transaction numbers are only allowed on a replica set member or mongos",
    "code": {
      "$numberInt": "20"
    },
    "codeName": "IllegalOperation"
  },
  "state": {}
}
