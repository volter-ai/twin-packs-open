{
  "name": "transaction-standalone",
  "why": "a find that starts a transaction, sent to a standalone server: the refusal LibreChat's probe meets",
  "oracle": "mongod 7.0.16 standalone",
  "setup": [
    {
      "insert": "things",
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "k": "a",
          "r": {
            "$oid": "0000000000000000000000b1"
          },
          "p": {
            "$numberInt": "1"
          }
        },
        {
          "_id": {
            "$numberInt": "2"
          },
          "k": "b",
          "r": {
            "$oid": "0000000000000000000000b2"
          },
          "p": {
            "$numberInt": "3"
          }
        },
        {
          "_id": {
            "$numberInt": "3"
          },
          "k": "a",
          "r": {
            "$oid": "0000000000000000000000b1"
          },
          "p": {
            "$numberInt": "2"
          }
        },
        {
          "_id": {
            "$numberInt": "4"
          },
          "k": "a",
          "p": {
            "$numberInt": "1"
          },
          "r": [
            {
              "$oid": "0000000000000000000000b3"
            },
            {
              "$oid": "0000000000000000000000b1"
