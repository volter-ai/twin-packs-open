{
  "name": "update-unordered",
  "why": "an unordered update of three statements whose second breaks a unique index: what the third does, and the answer",
  "oracle": "mongod 7.0.16 standalone",
  "setup": [
    {
      "createIndexes": "things",
      "indexes": [
        {
          "key": {
            "k": {
              "$numberInt": "1"
            }
          },
          "name": "k_1",
          "unique": true
        }
      ]
    },
    {
      "insert": "things",
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "k": "a"
        },
        {
          "_id": {
            "$numberInt": "2"
          },
          "k": "b"
        }
      ]
    }
  ],
  "ask": {
    "update": "things",
    "updates": [
      {
        "q": {
          "_id": {
            "$numberInt": "3"
          }
        },
        "u": {
          "$set": {
            "k": "c"
          }
        },
        "upsert": true
      },
      {
        "q": {
          "_id": {
            "$numberInt": "2"
          }
        },
        "u": {
          "$set": {
            "k": "a"
          }
        }
      },
      {
        "q": {
          "_id": {
            "$numberInt": "4"
          }
        },
        "u": {
          "$setOnInsert": {
            "k": "d"
          }
        },
        "upsert": true
      }
    ],
    "ordered": false
  },
  "answer": {
    "n": {
      "$numberInt": "2"
    },
    "writeErrors": [
      {
        "index": {
          "$numberInt": "1"
        },
        "code": {
          "$numberInt": "11000"
        },
        "errmsg": "E11000 duplicate key error collection: ask_update_unordered.things index: k_1 dup key: { k: \"a\" }",
        "keyPattern": {
          "k": {
            "$numberInt": "1"
          }
        },
        "keyValue": {
          "k": "a"
        }
      }
    ],
    "upserted": [
      {
        "index": {
          "$numberInt": "0"
        },
        "_id": {
          "$numberInt": "3"
        }
      },
      {
        "index": {
          "$numberInt": "2"
        },
        "_id": {
          "$numberInt": "4"
        }
      }
    ],
    "nModified": {
      "$numberInt": "0"
    },
    "ok": {
      "$numberDouble": "1.0"
    }
  },
  "state": {
    "things": {
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "k": "a"
        },
        {
          "_id": {
            "$numberInt": "2"
          },
          "k": "b"
        },
        {
          "_id": {
            "$numberInt": "3"
          },
          "k": "c"
        },
        {
          "_id": {
            "$numberInt": "4"
          },
          "k": "d"
        }
      ],
      "indexes": [
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "_id": {
              "$numberInt": "1"
            }
          },
          "name": "_id_"
        },
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "k": {
              "$numberInt": "1"
            }
          },
          "name": "k_1",
          "unique": true
        }
      ]
    }
  }
}
