{
  "name": "list-collections-full-named",
  "why": "the driver's db.listCollections({ name }): one collection by its name, in full, as LibreChat checks that a collection exists",
  "oracle": "mongod 7.0.16 standalone",
  "setup": [
    {
      "create": "things"
    },
    {
      "create": "others"
    }
  ],
  "ask": {
    "listCollections": {
      "$numberInt": "1"
    },
    "filter": {
      "name": "things"
    },
    "cursor": {},
    "nameOnly": false,
    "authorizedCollections": false
  },
  "answer": {
    "cursor": {
      "id": {
        "$numberLong": "0"
      },
      "ns": "ask_list_collections_full_named.$cmd.listCollections",
      "firstBatch": [
        {
          "name": "things",
          "type": "collection",
          "options": {},
          "info": {
            "readOnly": false,
            "uuid": {
              "$binary": {
                "base64": "c9w5UMDSQPGCsy2fd9Oe9A==",
                "subType": "04"
              }
            }
          },
          "idIndex": {
            "v": {
              "$numberInt": "2"
            },
            "key": {
              "_id": {
                "$numberInt": "1"
              }
            },
            "name": "_id_"
          }
        }
      ]
    },
    "ok": {
      "$numberDouble": "1.0"
    }
  },
  "state": {}
}
