{
  "name": "create-index-on-existing",
  "why": "an index made on a collection that already exists: what the answer says of the collection",
  "oracle": "mongod 7.0.16 standalone",
  "setup": [
    {
      "create": "people"
    }
  ],
  "ask": {
    "createIndexes": "people",
    "indexes": [
      {
        "key": {
          "email": {
            "$numberInt": "1"
          }
        },
        "name": "email_1",
        "unique": true
      }
    ]
  },
  "answer": {
    "numIndexesBefore": {
      "$numberInt": "1"
    },
    "numIndexesAfter": {
      "$numberInt": "2"
    },
    "createdCollectionAutomatically": false,
    "ok": {
      "$numberDouble": "1.0"
    }
  },
  "state": {
    "people": {
      "documents": [],
      "indexes": [
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "_id": {
              "$numberInt": "1"
            }
          },
          "name": "_id_"
        },
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "email": {
              "$numberInt": "1"
            }
          },
          "name": "email_1",
          "unique": true
        }
      ]
    }
  }
}
