{
  "name": "find-all",
  "why": "a find with an empty filter on a collection of two documents: the cursor it answers and the order",
  "oracle": "mongod 7.0.16 standalone",
  "setup": [
    {
      "insert": "people",
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "name": "Ada"
        },
        {
          "_id": {
            "$numberInt": "2"
          },
          "name": "Grace"
        }
      ]
    }
  ],
  "ask": {
    "find": "people",
    "filter": {}
  },
  "answer": {
    "cursor": {
      "firstBatch": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "name": "Ada"
        },
        {
          "_id": {
            "$numberInt": "2"
          },
          "name": "Grace"
        }
      ],
      "id": {
        "$numberLong": "0"
      },
      "ns": "ask_find_all.people"
    },
    "ok": {
      "$numberDouble": "1.0"
    }
  },
  "state": {}
}
