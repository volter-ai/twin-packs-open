{
  "name": "filter-projection-limit",
  "why": "a find with a projection of two fields without _id, a sort descending and a limit",
  "oracle": "mongod 7.0.16 standalone",
  "setup": [
    {
      "insert": "things",
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "s": "a",
          "n": {
            "$numberInt": "5"
          },
          "b": true,
          "at": {
            "$date": {
              "$numberLong": "1000"
            }
          },
          "ref": {
            "$oid": "0000000000000000000000a1"
          },
          "tags": [
            "x",
            "y"
          ]
        },
        {
          "_id": {
            "$numberInt": "2"
          },
          "s": "b",
          "n": {
            "$numberDouble": "5.0"
          },
          "b": false,
          "at": {
            "$date": {
              "$numberLong": "2000"
            }
          },
          "ref": {
            "$oid": "0000000000000000000000a2"
          },
          "tags": [
            "y"
          ]
        },
        {
          "_id": {
            "$numberInt": "3"
          },
          "s": null,
          "n": {
            "$numberLong": "7"
          },
          "at": {
            "$date": {
              "$numberLong": "3000"
            }
          },
          "tags": []
        },
        {
          "_id": {
            "$numberInt": "4"
          },
          "n": {
            "$numberInt": "9"
          },
          "b": true,
          "at": null
        },
        {
          "_id": {
            "$numberInt": "5"
          },
          "s": "a",
          "n": null,
          "b": null,
          "ref": {
            "$oid": "0000000000000000000000a1"
          },
          "tags": "x"
        },
        {
          "_id": {
            "$numberInt": "6"
          },
          "s": "c",
          "at": "not a date"
        }
      ]
    }
  ],
  "ask": {
    "find": "things",
    "filter": {},
    "sort": {
      "_id": {
        "$numberInt": "-1"
      }
    },
    "projection": {
      "s": {
        "$numberInt": "1"
      },
      "n": {
        "$numberInt": "1"
      },
      "_id": {
        "$numberInt": "0"
      }
    },
    "limit": {
      "$numberInt": "2"
    }
  },
  "answer": {
    "cursor": {
      "firstBatch": [
        {
          "s": "c"
        },
        {
          "s": "a",
          "n": null
        }
      ],
      "id": {
        "$numberLong": "0"
      },
      "ns": "ask_filter_projection_limit.things"
    },
    "ok": {
      "$numberDouble": "1.0"
    }
  },
  "state": {}
}
