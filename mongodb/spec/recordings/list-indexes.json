{
  "name": "list-indexes",
  "why": "the index list of a collection with one index beside its own: the cursor it answers",
  "oracle": "mongod 7.0.16 standalone",
  "setup": [
    {
      "createIndexes": "people",
      "indexes": [
        {
          "key": {
            "email": {
              "$numberInt": "1"
            }
          },
          "name": "email_1",
          "unique": true
        }
      ]
    }
  ],
  "ask": {
    "listIndexes": "people"
  },
  "answer": {
    "cursor": {
      "id": {
        "$numberLong": "0"
      },
      "ns": "ask_list_indexes.people",
      "firstBatch": [
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "_id": {
              "$numberInt": "1"
            }
          },
          "name": "_id_"
        },
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "email": {
              "$numberInt": "1"
            }
          },
          "name": "email_1",
          "unique": true
        }
      ]
    },
    "ok": {
      "$numberDouble": "1.0"
    }
  },
  "state": {}
}
