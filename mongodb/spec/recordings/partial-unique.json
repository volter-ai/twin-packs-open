          "$numberInt": "1"
        },
        "code": {
          "$numberInt": "11000"
        },
        "errmsg": "E11000 duplicate key error collection: ask_partial_unique.people index: g_1_t_1 dup key: { g: \"x\", t: \"a\" }",
        "keyPattern": {
          "g": {
            "$numberInt": "1"
          },
          "t": {
            "$numberInt": "1"
          }
        },
        "keyValue": {
          "g": "x",
          "t": "a"
        }
      }
    ],
    "ok": {
      "$numberDouble": "1.0"
    }
  },
  "state": {
    "people": {
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "t": "a"
        },
        {
