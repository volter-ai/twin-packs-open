{
  "name": "partial-unique",
  "why": "a unique index with a partial filter (the field exists): documents outside the filter may repeat the key, one inside may not",
  "oracle": "mongod 7.0.16 standalone",
  "setup": [
    {
      "createIndexes": "people",
      "indexes": [
        {
          "key": {
            "g": {
              "$numberInt": "1"
            },
            "t": {
              "$numberInt": "1"
            }
          },
          "name": "g_1_t_1",
          "unique": true,
          "partialFilterExpression": {
            "g": {
              "$exists": true
            }
          }
        }
      ]
    },
    {
      "insert": "people",
