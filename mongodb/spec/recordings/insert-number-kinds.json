{
  "name": "insert-number-kinds",
  "why": "whether an _id written as a 32-bit integer and one written as a double of the same value are the same _id",
  "oracle": "mongod 7.0.16 standalone",
  "setup": [
    {
      "insert": "people",
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "name": "Ada"
        }
      ]
    }
  ],
  "ask": {
    "insert": "people",
    "documents": [
      {
        "_id": {
          "$numberDouble": "1.0"
        },
        "name": "Again"
      }
    ]
  },
  "answer": {
    "n": {
      "$numberInt": "0"
    },
    "writeErrors": [
      {
        "index": {
          "$numberInt": "0"
        },
        "code": {
          "$numberInt": "11000"
        },
        "errmsg": "E11000 duplicate key error collection: ask_insert_number_kinds.people index: _id_ dup key: { _id: 1.0 }",
        "keyPattern": {
          "_id": {
            "$numberInt": "1"
          }
        },
        "keyValue": {
          "_id": {
            "$numberDouble": "1.0"
          }
        }
      }
    ],
    "ok": {
      "$numberDouble": "1.0"
    }
  },
  "state": {
    "people": {
      "documents": [
        {
          "_id": {
            "$numberInt": "1"
          },
          "name": "Ada"
        }
      ],
      "indexes": [
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "_id": {
              "$numberInt": "1"
            }
          },
          "name": "_id_"
        }
      ]
    }
  }
}
