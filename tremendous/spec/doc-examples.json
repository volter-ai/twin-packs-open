  {
    "title": "Placing an order for a LINK reward",
    "source": "https://developers.tremendous.com/docs/link-delivery",
    "operation": "create-order",
    "request": {
      "method": "POST",
      "url": "https://testflight.tremendous.com/api/v2/orders"
    },
    "input": {
      "payment": {
        "funding_source_id": "BALANCE"
      },
      "reward": {
        "value": {
          "denomination": 50,
          "currency_code": "USD"
        },
        "delivery": {
          "method": "LINK"
        },
        "recipient": {
          "name": "Jane Doe",
          "email": "recipient@example.com"
        },
        "products": [
          "OKMHM2X2OHYV"
        ]
      }
    },
    "output": {
      "order": {
        "id": "SFZCMH4NMC5X",
        "external_id": null,
        "created_at": "2023-01-10T21:44:06.441Z",
        "status": "EXECUTED",
        "channel": "API",
        "payment": {
          "subtotal": 50,
          "total": 50,
          "fees": 0
        },
        "rewards": [
          {
            "id": "4SBVBQGUZOGR",
            "order_id": "SFZCMH4NMC5X",
            "created_at": "2023-01-10T21:44:06.567Z",
            "value": {
              "denomination": 50,
              "currency_code": "USD"
            },
            "delivery": {
              "method": "LINK",
              "status": "SUCCEEDED",
              "link": "https://testflight.tremendous.com/rewards/payout/d0jgy1s8n--zkeqp-za8dbvrazboibjixi0cwxapb9r"
