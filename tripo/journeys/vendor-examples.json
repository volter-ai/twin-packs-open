{
  "vendor": "tripo",
  "author": "Contributor 92",
  "host": "api.tripo3d.ai",
  "about": "Replay the pinned Python SDK README's Check Account Balance and API reference's get_balance examples over their documented HTTP request. Setup supplies the account and captured API key assumed by TripoClient; neither publication provides a literal numeric response. Retained unknown-request recordings replay the front 404 and protected-prefix authentication refusal without creating a task or changing the customer life.",
  "steps": [
    {
      "name": "Recorded API-front unknown request",
      "example": "gap#doc Recorded API-front unknown request",
      "method": "GET",
      "path": "https://api.tripo3d.ai/unknown-path",
      "status": 404,
      "expect": [
        {
          "header": "content-type",
          "equals": "text/html"
        },
        {
          "path": "",
          "equals": "<html>\n<head><title>404 Not Found</title></head>\n<body>\n<center><h1>404 Not Found</h1></center>\n<hr><center>openresty/1.21.4.1</center>\n</body>\n</html>\n"
        }
      ]
    },
    {
      "name": "Recorded protected-prefix unknown request without a key",
      "example": "gap#doc Recorded protected-prefix unknown request without a key",
      "method": "GET",
      "path": "https://api.tripo3d.ai/v2/openapi/unknown-path",
      "status": 401,
      "expect": [
        {
          "header": "content-type",
          "equals": "application/json"
        },
        {
          "path": "",
          "equals": {
            "code": 1002,
            "message": "Authentication failed",
            "suggestion": "Check if your credentials is valid, and ensure you set it correctly"
          }
        }
      ]
    },
    {
      "name": "Prepare the credited account assumed by the SDK example",
      "method": "POST",
      "path": "/_twin/accounts",
      "status": 201,
      "body": {
        "balance": 3000
      },
      "capture": {
        "key": "api_key"
      },
      "expect": [
        {
          "path": "balance",
          "equals": 3000
        }
      ]
    },
    {
      "name": "Check Account Balance: get_balance reads available and frozen credits",
      "example": "getBalance#doc Check Account Balance",
      "method": "GET",
      "path": "/v2/openapi/user/balance",
      "status": 200,
      "headers": {
        "Authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "",
          "equals": {
            "code": 0,
            "data": {
              "balance": 3000,
              "frozen": 0
            }
          }
        }
      ]
    },
    {
      "name": "API reference get_balance example reads available and frozen credits",
      "example": "getBalance#doc get_balance API reference",
      "method": "GET",
      "path": "/v2/openapi/user/balance",
      "status": 200,
      "headers": {
        "Authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "",
          "equals": {
            "code": 0,
            "data": {
              "balance": 3000,
              "frozen": 0
            }
          }
        }
      ]
    }
  ]
}
