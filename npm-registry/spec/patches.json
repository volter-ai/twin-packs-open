{
  "patches": [
    {
      "op": "replace",
      "path": "/calls/8/url",
      "value": "/{spec.escapedName}/-/{tarball}/-rev/{_rev}",
      "why": "Unpublishing a package's last version removes its tarball at the tarball URL's path (getPathname(dist.tarball)), which the package metadata gives as /<name>/-/<name>-<version>.tgz.",
      "source": {
        "url": "https://raw.githubusercontent.com/npm/registry/main/docs/responses/package-metadata.md",
        "quote": "\"tarball\": \"https://registry.npmjs.org/tiny-tarball/-/tiny-tarball-1.0.0.tgz\""
      }
    },
    {
      "op": "replace",
      "path": "/calls/18/url",
      "value": "/-/v1/done",
      "why": "A web login's done URL is the one POST /-/v1/login answers (doneUrl); npm-profile's own test gives its path.",
      "source": {
        "url": "https://raw.githubusercontent.com/npm/npm-profile/v11.0.1/test/index.js",
        "quote": "doneUrl: 'https://registry.npmjs.org:443/-/v1/done?sessionId=123'"
      }
    },
    {
      "op": "replace",
      "path": "/calls/23/url",
      "value": "/-/npm/v1/tokens",
      "why": "paginate is called with the token list's path, then each page's urls.next.",
      "source": {
        "url": "https://raw.githubusercontent.com/npm/npm-profile/v11.0.1/lib/index.js",
        "quote": "const listTokens = (opts = {}) => paginate('/-/npm/v1/tokens', opts)"
      }
    },
    {
      "op": "replace",
      "path": "/calls/1/url",
      "value": "/-/npm/v1/attestations/{spec}",
      "why": "A version's attestations are fetched at dist.attestations.url's path, which the registry gives as /-/npm/v1/attestations/<name>@<version>.",
      "source": {
        "url": "https://registry.npmjs.org/sigstore/2.0.0",
        "quote": "\"url\":\"https://registry.npmjs.org/-/npm/v1/attestations/sigstore@2.0.0\""
      }
    },
    {
      "op": "replace",
      "path": "/calls/2/url",
      "value": "/{name}/-/{tarball}",
      "why": "A tarball is fetched from the version's dist.tarball, /<name>/-/<name>-<version>.tgz.",
      "source": {
        "url": "https://raw.githubusercontent.com/npm/registry/main/docs/responses/package-metadata.md",
        "quote": "\"tarball\": \"https://registry.npmjs.org/tiny-tarball/-/tiny-tarball-1.0.0.tgz\""
      }
    },
    {
      "op": "add",
      "path": "/calls/-",
      "value": {
        "client": "registry.version",
        "line": 0,
        "method": "GET",
        "url": "/{name}/{version}"
      },
      "why": "The registry answers one version of a package, by its number or a dist-tag, at /{package}/{version}; npm's client reads the whole document instead, so its calls do not name the route.",
      "source": {
        "url": "https://raw.githubusercontent.com/npm/registry/main/docs/REGISTRY-API.md",
        "quote": "| version | String | **Path** | \u2705         | a version number or `latest`        |"
      }
    },
    {
      "op": "replace",
      "path": "/calls/19/url",
      "value": "/-/user/org.couchdb.user:{username}",
      "why": "npm's login and adduser put the user document at the user's own path, with nothing after it (putCouch's path is empty for both).",
      "source": {
        "url": "https://raw.githubusercontent.com/npm/npm-profile/v11.0.1/lib/index.js",
        "quote": "return putCouch('', username, body, opts)"
      }
    },
