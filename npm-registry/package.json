{
  "name": "@volter/twin-npm-registry",
  "version": "3.0.3",
  "description": "The npm registry as a Protocol 3 twin: publish, install, version metadata, provenance, dist-tags and search, from npm's own client.",
  "author": "Volter (https://github.com/volter-ai)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js"
  },
