    "journeys",
    "spec",
    "README.md",
    "!**/*.test.ts",
    "LICENSE",
    "dist",
    "generated"
  ],
  "peerDependencies": {
    "@volter/world-core": ">=3.0.163",
    "@volter/world-runtime": ">=3.0.184"
  },
  "engines": {
    "node": ">=22.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/twin-packs-open.git",
    "directory": "npm-registry"
  },
  "homepage": "https://github.com/volter-ai/twin-packs-open/tree/main/npm-registry#readme",
  "dependencies": {
    "@sigstore/bundle": "4.0.0",
    "@sigstore/protobuf-specs": "0.5.2",
    "@sigstore/verify": "3.1.1"
  },
  "bugs": {
    "url": "https://github.com/volter-ai/twin-packs-open/issues"
  }
