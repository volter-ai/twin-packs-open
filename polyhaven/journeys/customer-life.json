{
  "vendor": "polyhaven",
  "author": "Contributor 80",
  "host": "api.polyhaven.com",
  "about": "A game studio uses small valid synthetic geometry and lighting fixtures in the Poly Haven catalog to exercise its editor import before choosing production assets. Each negative read is a stale selection or mistyped filter during separate sittings.",
  "steps": [
    {
      "name": "The publisher makes an armchair import fixture: a textured triangle in glTF",
      "method": "POST",
      "path": "/_twin/assets",
      "status": 201,
      "body": {
        "id": "ArmChair_01",
        "type": "models",
        "name": "Arm Chair 01",
        "categories": [
          "furniture",
          "seating"
        ],
        "tags": [
          "chair",
          "victorian",
          "wood"
        ],
        "authors": {
          "Kirill Sannikov": "All"
        },
        "category": "Furniture/Seating/Chairs",
        "date_published": 1585605600,
        "files": {
          "gltf": {
            "1k": {
              "gltf": {
                "text": "{\"asset\":{\"version\":\"2.0\"},\"buffers\":[{\"uri\":\"ArmChair_01.bin\",\"byteLength\":66}],\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":24},{\"buffer\":0,\"byteOffset\":60,\"byteLength\":6}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\",\"min\":[0,0,0],\"max\":[1,1,0]},{\"bufferView\":1,\"componentType\":5126,\"count\":3,\"type\":\"VEC2\"},{\"bufferView\":2,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"}],\"images\":[{\"uri\":\"textures/Armchair_01_diff_1k.png\"}],\"textures\":[{\"source\":0}],\"materials\":[{\"pbrMetallicRoughness\":{\"baseColorTexture\":{\"index\":0}}}],\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0,\"TEXCOORD_0\":1},\"indices\":2,\"material\":0}]}],\"nodes\":[{\"mesh\":0}],\"scenes\":[{\"nodes\":[0]}],\"scene\":0}",
                "include": {
                  "ArmChair_01.bin": {
                    "base64": "AAAAAAAAAAAAAAAAAACAPwAAAAAAAAAAAAAAAAAAgD8AAAAAAAAAAAAAAAAAAIA/AAAAAAAAAAAAAIA/AAABAAIA"
                  },
                  "textures/Armchair_01_diff_1k.png": {
                    "base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGNoSHAAAAKEASFpy73iAAAAAElFTkSuQmCC"
                  }
                }
              }
            }
          }
        },
        "thumbnail": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGNoSHAAAAKEASFpy73iAAAAAElFTkSuQmCC"
      },
      "capture": {
        "thumb": "thumbnail_url"
      },
      "expect": [
        {
          "path": "type",
          "equals": 2
        },
        {
          "path": "name",
          "equals": "Arm Chair 01"
        },
        {
          "path": "date_published",
          "equals": 1585605600
        },
        {
          "path": "thumbnail_url",
          "matches": "^https://cdn\\.polyhaven\\.com/asset_img/thumbs/ArmChair_01\\.png\\?width=256&height=256&v=[0-9a-f]{8}$"
        },
        {
          "path": "files_hash",
          "matches": "^[0-9a-f]{40}$"
        }
      ]
    },
    {
      "name": "Wooden Table 02, a model in furniture and table",
      "method": "POST",
      "path": "/_twin/assets",
      "status": 201,
      "body": {
        "id": "WoodenTable_02",
        "type": "models",
        "name": "Wooden Table 02",
        "categories": [
          "furniture",
          "table"
        ],
        "tags": [
          "table",
          "wood"
        ],
        "files": {
          "gltf": {
            "1k": {
              "gltf": {
                "text": "{\"asset\":{\"version\":\"2.0\"},\"scenes\":[{\"nodes\":[]}],\"scene\":0}"
              }
            }
          }
        }
      },
      "expect": [
        {
          "path": "thumbnail_url",
          "equals": "https://cdn.polyhaven.com/asset_img/thumbs/WoodenTable_02.png?width=256&height=256"
        }
      ],
      "capture": {
        "tableThumb": "thumbnail_url"
      }
    },
    {
      "name": "Kloofendal Sky, an HDRI with a 1k hdr and exr",
      "method": "POST",
      "path": "/_twin/assets",
      "status": 201,
      "body": {
        "id": "kloofendal_sky",
        "type": "hdris",
        "name": "Kloofendal Sky",
        "categories": [
          "outdoor",
          "skies"
        ],
        "files": {
          "hdri": {
            "1k": {
              "hdr": {
                "base64": "Iz9SQURJQU5DRQpGT1JNQVQ9MzItYml0X3JsZV9yZ2JlCgotWSAxICtYIDEKgGBAgQ=="
              },
              "exr": {
                "base64": ""
              }
            }
          }
        }
      },
      "expect": [
        {
          "path": "type",
          "equals": 0
        }
      ]
    },
    {
      "name": "The next editor or publisher sitting",
      "wait": "1h"
    },
    {
      "name": "Publishing the same id again is refused",
      "method": "POST",
      "path": "/_twin/assets",
      "status": 409,
      "body": {
        "id": "ArmChair_01",
        "type": "models",
        "name": "Again",
        "categories": [],
        "files": {}
      }
    },
    {
      "name": "Chapter 2: the editor lists the models, keyed by id",
      "method": "GET",
      "path": "/assets?type=models",
      "status": 200,
      "headers": {
        "User-Agent": "VOLTER-Engine/1.0"
      },
      "expect": [
        {
          "path": "ArmChair_01.name",
          "equals": "Arm Chair 01"
        },
        {
          "path": "ArmChair_01.type",
          "equals": 2
        },
        {
          "path": "ArmChair_01.categories",
          "equals": [
            "furniture",
            "seating"
          ]
        },
        {
          "path": "ArmChair_01.tags",
          "equals": [
            "chair",
            "victorian",
            "wood"
          ]
        },
        {
          "path": "WoodenTable_02.name",
          "equals": "Wooden Table 02"
        },
        {
          "path": "kloofendal_sky",
          "exists": false
        },
        {
          "path": "ArmChair_01.id",
          "exists": false
        },
        {
          "path": "ArmChair_01._files",
          "exists": false
        }
      ]
    },
    {
      "name": "The next editor or publisher sitting",
      "wait": "3h"
    },
    {
      "name": "Narrowed to furniture,seating: only the armchair",
      "method": "GET",
      "path": "/assets?type=models&categories=furniture,seating",
      "status": 200,
      "headers": {
        "User-Agent": "VOLTER-Engine/1.0"
      },
      "expect": [
        {
          "path": "ArmChair_01.name",
          "equals": "Arm Chair 01"
        },
        {
          "path": "WoodenTable_02",
          "exists": false
        }
      ]
    },
    {
      "name": "The next editor or publisher sitting",
      "wait": "1h"
    },
    {
      "name": "The editor mistypes an unknown category and is refused",
      "method": "GET",
      "path": "/assets?type=models&categories=nothing_here",
      "status": 400,
      "headers": {
        "User-Agent": "VOLTER-Engine/1.0"
      }
    },
    {
      "name": "The next editor or publisher sitting",
      "wait": "1h"
    },
    {
      "name": "The HDRIs: only the sky",
      "method": "GET",
      "path": "/assets?type=hdris",
      "status": 200,
      "headers": {
        "User-Agent": "VOLTER-Engine/1.0"
      },
      "expect": [
        {
          "path": "kloofendal_sky.type",
          "equals": 0
        },
        {
          "path": "ArmChair_01",
          "exists": false
        }
      ]
    },
    {
      "name": "The next editor or publisher sitting",
      "wait": "1h"
    },
    {
      "name": "An unsupported type is Poly Haven's 400 text",
      "method": "GET",
      "path": "/assets?type=brushes",
      "status": 400,
      "headers": {
        "User-Agent": "VOLTER-Engine/1.0"
      }
    },
    {
      "name": "The next editor or publisher sitting",
      "wait": "1h"
    },
    {
      "name": "Chapter 3: the models' categories, most first, with all",
      "method": "GET",
      "path": "/categories/models",
      "status": 200,
      "headers": {
        "User-Agent": "VOLTER-Engine/1.0"
      },
      "expect": [
        {
          "path": "all",
          "equals": 2
        },
        {
          "path": "furniture",
          "equals": 2
        },
        {
          "path": "seating",
          "equals": 1
        },
        {
          "path": "table",
          "equals": 1
        },
        {
          "path": "outdoor",
          "exists": false
        }
      ]
    },
    {
      "name": "The next editor or publisher sitting",
      "wait": "1h"
    },
    {
      "name": "Within furniture: furniture itself is not counted again, and all is not given",
      "method": "GET",
      "path": "/categories/models?in=furniture",
      "status": 200,
      "headers": {
        "User-Agent": "VOLTER-Engine/1.0"
      },
      "expect": [
        {
          "path": "seating",
          "equals": 1
        },
        {
          "path": "table",
          "equals": 1
        },
        {
          "path": "furniture",
          "exists": false
        },
        {
          "path": "all",
          "exists": false
        }
      ]
    },
    {
      "name": "The next editor or publisher sitting",
      "wait": "1h"
    },
    {
      "name": "all as the type: each type's count",
      "method": "GET",
      "path": "/categories/all",
      "status": 200,
      "headers": {
        "User-Agent": "VOLTER-Engine/1.0"
      },
      "expect": [
        {
          "path": "all",
          "equals": 3
        },
        {
          "path": "models",
          "equals": 2
        },
        {
          "path": "hdris",
          "equals": 1
        }
      ]
    },
    {
      "name": "Chapter 4: the armchair's files",
      "method": "GET",
      "path": "/files/ArmChair_01",
      "status": 200,
      "headers": {
        "User-Agent": "VOLTER-Engine/1.0"
      },
      "capture": {
        "gltfUrl": "gltf.1k.gltf.url",
        "binUrl": "text:\"ArmChair_01\\.bin\":\\{[^}]*\"url\":\"([^\"]+)\"",
        "textureUrl": "text:\"textures/Armchair_01_diff_1k\\.png\":\\{[^}]*\"url\":\"([^\"]+)\""
      },
      "expect": [
        {
          "path": "gltf.1k.gltf.url",
          "equals": "https://dl.polyhaven.org/file/ph-assets/Models/gltf/1k/ArmChair_01/ArmChair_01_1k.gltf"
        },
        {
          "path": "gltf.1k.gltf.size",
          "equals": 766
        },
        {
          "path": "gltf.1k.gltf.md5",
          "equals": "151cd7924581c19408be9b2d14f7cc21"
        }
      ]
    },
    {
      "name": "The next editor or publisher sitting",
      "wait": "1h"
    },
    {
      "name": "The sky's files: the hdr and the exr at 1k",
      "method": "GET",
      "path": "/files/kloofendal_sky",
      "status": 200,
      "headers": {
        "User-Agent": "VOLTER-Engine/1.0"
      },
      "expect": [
        {
          "path": "hdri.1k.hdr.url",
          "equals": "https://dl.polyhaven.org/file/ph-assets/HDRIs/hdr/1k/kloofendal_sky/kloofendal_sky_1k.hdr"
        },
        {
          "path": "hdri.1k.exr.url",
          "equals": "https://dl.polyhaven.org/file/ph-assets/HDRIs/exr/1k/kloofendal_sky/kloofendal_sky_1k.exr"
        }
      ]
    },
    {
      "name": "The next editor or publisher sitting",
      "wait": "1h"
    },
    {
      "name": "The studio enters a nonexistent slug in the importer",
      "method": "GET",
      "path": "/files/NoSuchAsset_01",
      "status": 404,
      "headers": {
        "User-Agent": "VOLTER-Engine/1.0"
      }
    },
    {
      "name": "Chapter 5: the editor downloads the glTF",
      "method": "GET",
      "path": "{gltfUrl}",
      "status": 200,
      "expect": [
        {
          "path": "asset.version",
          "equals": "2.0"
        },
        {
          "header": "content-length",
          "equals": "766"
        },
        {
          "header": "x-bz-file-name",
          "equals": "Models/gltf/1k/ArmChair_01/ArmChair_01_1k.gltf"
        }
      ]
    },
    {
      "name": "\u2026its .bin",
      "method": "GET",
      "path": "{binUrl}",
      "status": 200,
      "expect": [
        {
          "header": "content-length",
          "equals": "66"
        },
        {
          "header": "content-type",
          "equals": "application/octet-stream"
        }
      ]
    },
    {
      "name": "\u2026and its texture",
      "method": "GET",
      "path": "{textureUrl}",
      "status": 200,
      "expect": [
        {
          "header": "content-length",
          "equals": "69"
        }
      ]
    },
    {
      "name": "The next editor or publisher sitting",
      "wait": "1h"
    },
    {
      "name": "An operator mistypes a file name through the documented B2 download-by-name door",
      "method": "GET",
      "path": "https://dl.polyhaven.org/file/ph-assets/Models/gltf/1k/ArmChair_01/ArmChair_01_8k.gltf",
      "status": 404,
      "expect": [
        {
          "path": "code",
          "equals": "not_found"
        },
        {
          "path": "message",
          "equals": "File with such name does not exist."
        },
        {
          "path": "status",
          "equals": 404
        }
      ]
    },
    {
      "name": "The browser shows the armchair's thumbnail",
      "method": "GET",
      "path": "{thumb}",
      "status": 200,
      "expect": [
        {
          "header": "content-type",
          "equals": "image/png"
        }
      ]
    },
    {
      "name": "The next editor or publisher sitting",
      "wait": "1h"
    },
    {
      "name": "The table was published without one: 404",
      "method": "GET",
      "path": "{tableThumb}",
      "status": 404
    }
  ]
}
