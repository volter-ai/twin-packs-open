      "headers": {
        "authorization": "Bearer {ci}"
      },
      "capture": {
        "t_key": "0.public"
      },
      "expect": [
        {
          "path": "0.dsn.public",
          "contains": "{t_key}"
        },
        {
          "path": "0.projectId",
          "equals": "{t_proj}"
        }
      ],
      "evidence": "spec:listProjectKeys"
    },
    {
      "name": "Priya creates the scheduler project through Sentry API",
