    {
      "name": "Monday 5 January, 09:00: Harbourline puts Sentry on Rallly and Twenty",
      "wait": "6300m"
    },
    {
      "name": "Harbourline signs up: its first project rallly and CI credential",
      "method": "POST",
      "path": "/_twin/app-credentials",
      "status": 201,
      "body": {
        "organization": "harbourline",
        "name": "Harbourline",
        "project": "rallly",
        "platform": "javascript-nextjs"
      },
      "capture": {
        "org": "org",
        "ci": "auth_token",
        "r_key": "text:https://([0-9a-f]{32})@",
        "r_host": "text:@(o[0-9]+\\.ingest\\.us\\.sentry\\.io)",
        "r_proj": "text:sentry\\.io/([0-9]+)",
        "org_id": "org_id"
      },
      "evidence": "sentry/src/manifest.ts:credentialDoor"
    },
    {
      "name": "Priya issues the CI token Cal reads as SENTRY_AUTH_TOKEN",
      "method": "POST",
      "path": "/_twin/auth-tokens",
      "status": 201,
      "body": {
        "organization": "harbourline",
        "name": "cal-build",
        "kind": "org"
      },
      "capture": {
        "cal_ci": "token"
      },
      "expect": [
        {
          "path": "token",
          "contains": "sntrys_"
        }
      ],
      "evidence": "calcom/cal.diy@54343aa685ae:apps/web/scripts/create-sentry-release.js:7"
    },
    {
      "name": "Priya creates the twenty project through Sentry API",
      "method": "POST",
      "path": "https://sentry.io/api/0/organizations/harbourline/projects/",
      "status": 201,
      "headers": {
        "authorization": "Bearer {ci}"
      },
      "body": {
        "name": "twenty",
        "slug": "twenty",
        "platform": "node"
      },
      "capture": {
        "t_proj": "id"
      },
      "expect": [
        {
          "path": "slug",
          "equals": "twenty"
        },
        {
          "path": "name",
          "equals": "twenty"
        },
        {
          "path": "platform",
          "equals": "node"
        }
      ],
      "evidence": "spec:createOrganizationProject"
    },
    {
      "name": "She reads the twenty DSN from its client key",
      "method": "GET",
      "path": "https://sentry.io/api/0/projects/harbourline/twenty/keys/",
