                    "type": "string"
                  },
                  "context_id": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "env_vars": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Newline-delimited events ending with end_of_execution",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
