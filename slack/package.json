{
  "name": "@volter/twin-slack",
  "version": "3.0.3",
  "description": "Local Slack twin \u2014 a faithful, stateful local Slack Web API your real Slack SDKs talk to unmodified, with its OAuth install, pages and incoming webhooks. Built on @volter/world-core.",
  "keywords": [
    "twin",
    "local",
    "mock",
    "mirror",
    "simulator",
    "fixtures",
    "testing",
    "sdk",
    "api",
    "localstack",
    "slack",
    "chat",
    "webhooks"
  ],
  "author": "Volter (https://github.com/volter-ai)",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "journeys",
    "spec",
    "README.md",
    "LICENSE",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "dist",
    "generated"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/twin-packs-open.git",
    "directory": "slack"
  },
  "homepage": "https://github.com/volter-ai/twin-packs-open/tree/main/slack#readme",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "world-slack": "dist/src/cli.js"
  },
  "dependencies": {
    "@volter/world-ui": "^1.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "peerDependencies": {
    "@volter/world-core": "^3.0.87"
  },
  "devDependencies": {
    "@slack/web-api": "^7.17.0",
    "@types/bun": "^1.2.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.3"
  },
  "bugs": {
    "url": "https://github.com/volter-ai/twin-packs-open/issues"
  }
}
