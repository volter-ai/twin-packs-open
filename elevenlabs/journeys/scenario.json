{
 "handlers": [
  {
   "id": "bookings-confirmed",
   "on": { "lastMessageIsToolResult": true, "toolResultFor": "book_class" },
   "respond": { "text": "You're booked into Thursday's Yin and Saturday's flow. See you on the mat." }
  },
  {
   "id": "next-yin",
   "on": { "userTextIncludes": "next Yin class" },
   "respond": { "text": "The next Yin class is Thursday at seven in the evening, in studio two." }
  },
  {
   "id": "book-two-classes",
   "on": { "userTextIncludes": "book me into" },
   "respond": {
    "toolCalls": [
     { "name": "book_class", "arguments": { "class": "Yin, Thursday 19:00" } },
     { "name": "book_class", "arguments": { "class": "Vinyasa flow, Saturday 08:00" } }
    ]
   }
  },
  {
   "id": "llm-outage",
   "on": { "userTextIncludes": "yesterday's class" },
   "fault": { "kind": "status", "status": 503, "message": "The agent's LLM is unavailable." }
  }
 ]
}
