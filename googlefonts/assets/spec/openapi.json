{
  "openapi": "3.0.3",
  "info": {
    "title": "Google Fonts font-file hosts",
    "version": "2026-10-12"
  },
  "servers": [
    {
      "url": "https://fonts.gstatic.com"
    }
  ],
  "paths": {
    "/s/{file}": {
      "get": {
        "operationId": "getFontFile",
        "description": "Download the font-file bytes named by a Google Fonts stylesheet src URL.",
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The font-file bytes at the returned stylesheet URL",
            "content": {
              "font/eot": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "font/ttf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "font/woff": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "font/woff2": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Font file not found",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "files"
        ]
      }
    },
    "/l/font": {
      "get": {
        "operationId": "getLegacyFontFile",
        "description": "Download the font-file bytes named by a Google Fonts stylesheet src URL for a legacy browser.",
        "parameters": [
          {
            "name": "kit",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "skey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "v",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The font-file bytes at the returned stylesheet URL",
            "content": {
              "font/eot": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "font/ttf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "font/woff": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "font/woff2": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Font file not found",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "files"
        ]
      }
    }
  }
}
