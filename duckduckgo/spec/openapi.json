{
  "openapi": "3.0.3",
  "info": {
    "title": "DuckDuckGo demanded search wires",
    "version": "2026-10-03"
  },
  "servers": [
    {
      "url": "https://html.duckduckgo.com"
    }
  ],
  "paths": {
    "/html/": {
      "get": {
        "operationId": "searchHtml",
        "description": "Anonymous HTML search. Successful result structure is recorded; empty-result flow is unmodeled.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The query echoed in the recorded search form."
          }
        ],
        "responses": {
          "200": {
            "description": "Recorded result page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "The vendor HTML document, not a JSON envelope."
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "searchHtmlPost",
        "description": "The recorded form declares POST; no demanded caller posts it. Answer unmodeled.",
        "responses": {
          "default": {
            "description": "Not recorded",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "The vendor HTML document, not a JSON envelope."
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "operationId": "browserSearch",
        "servers": [
          {
            "url": "https://duckduckgo.com"
          }
        ],
        "description": "Workbench browser navigation: recorded HTTP 202 script-driven shell with anomaly detection and a noscript HTML link. Script-supplied results and solved challenge remain unestablished.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Recorded search shell with anomalyDetectionBlock",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "The vendor HTML document, not a JSON envelope."
                }
              }
            }
          }
        }
      }
    }
  }
}
