{
  "name": "@volter/twin-github",
  "version": "3.0.9",
  "description": "Local GitHub repository, issue, pull-request and git workflows over shared synthetic state. REST, GraphQL and Actions scope is documented in the README.",
  "keywords": [
    "twin",
    "local",
    "mock",
    "mirror",
    "simulator",
    "fixtures",
    "testing",
    "sdk",
    "api",
    "localstack",
    "github",
    "octokit",
    "graphql",
    "git"
  ],
  "author": "Volter (https://github.com/volter-ai)",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "journeys",
    "spec",
    "client",
    "README.md",
    "LICENSE",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "dist",
    "generated"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/twin-packs-open.git",
    "directory": "github"
  },
  "homepage": "https://github.com/volter-ai/twin-packs-open/tree/main/github#readme",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "world-github": "dist/src/cli.js"
  },
  "dependencies": {
    "@volter/world-ui": "^1.0.127",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "graphql": "16.14.2"
  },
  "peerDependencies": {
    "@volter/world-core": "^3.0.127"
  },
  "devDependencies": {
    "@octokit/rest": "22.0.1",
    "@types/bun": "^1.2.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.3"
  },
  "bugs": {
    "url": "https://github.com/volter-ai/twin-packs-open/issues"
  }
}
