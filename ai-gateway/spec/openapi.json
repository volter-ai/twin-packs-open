  "/v4/ai/language-model": {
   "post": {
    "operationId": "languageModel",
    "summary": "A language model call (the AI SDK protocol)",
    "description": "The AI SDK's language-model call, as @ai-sdk/gateway posts it to `${baseURL}/language-model` (baseURL `https://ai-gateway.vercel.sh/v4/ai`): the body is the call's LanguageModelV4 options, the model in the `ai-language-model-id` header, streaming in `ai-language-model-streaming`; the answer is a LanguageModelV4 generate result, or its stream parts as Server-Sent Events.",
    "externalDocs": {
     "url": "https://unpkg.com/@ai-sdk/gateway@4.0.80/dist/index.js"
    },
    "parameters": [
     {
      "name": "ai-language-model-id",
      "in": "header",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "ai-language-model-streaming",
      "in": "header",
      "required": true,
      "schema": {
       "type": "string",
       "enum": [
        "true",
        "false"
       ]
      }
     },
     {
      "name": "ai-language-model-specification-version",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "ai-gateway-auth-method",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "api-key",
        "oidc"
       ]
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "prompt": {
          "type": "array",
          "items": {
           "type": "object"
          }
         },
         "tools": {
          "type": "array",
          "items": {
           "type": "object"
          }
         },
         "toolChoice": {
          "type": "object"
         },
         "responseFormat": {
          "type": "object"
         },
         "maxOutputTokens": {
          "type": "integer"
         },
         "temperature": {
          "type": "number"
         },
         "providerOptions": {
          "type": "object"
         }
        },
        "required": [
         "prompt"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "A LanguageModelV4 generate result, or its stream parts as Server-Sent Events",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       },
       "text/event-stream": {
        "schema": {
         "type": "string"
        }
       }
      }
     },
     "400": {
      "description": "Bad Request: invalid request parameters",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "Unauthorized: invalid or missing authentication",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "Not Found: model or endpoint not found",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
      "description": "Too Many Requests: rate limit exceeded",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
