  "/v4/ai/evaluation-model": {
   "post": {
    "operationId": "evaluationModel",
    "summary": "Evaluate state against named questions",
    "description": "Native EvaluationModelV4 protocol sent by @ai-sdk/gateway 4.0.87: ai-model-id selects the model; the JSON body carries state, questions and providerOptions. Answers are native boolean, choice or score values.",
    "externalDocs": {
     "url": "https://unpkg.com/@ai-sdk/gateway@4.0.87/dist/index.js"
    },
    "parameters": [
     {
      "in": "header",
      "name": "ai-model-id",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "header",
      "name": "ai-evaluation-model-specification-version",
      "schema": {
       "type": "string",
       "enum": [
        "4"
       ]
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "state",
         "questions"
        ],
        "properties": {
         "state": {},
         "questions": {
          "type": "object"
         },
         "providerOptions": {
          "type": "object"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Native named answers with optional warnings, usage, rounding and providerMetadata",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "answers"
         ],
         "properties": {
          "answers": {
           "type": "object"
          },
          "warnings": {
           "type": "array",
           "items": {
            "type": "object"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer",
    "description": "An AI Gateway API key, or a Vercel OIDC token"
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "object",
      "properties": {
       "message": {
        "type": "string"
       },
       "type": {
        "type": "string"
       },
       "param": {},
       "code": {
        "type": "string"
       }
      },
      "required": [
       "message",
       "type"
      ]
     },
     "generationId": {
      "type": "string"
     }
    },
    "required": [
     "error"
    ],
    "description": "The error body: {\"error\": {\"message\", \"type\", \"param\", \"code\"}}."
   },
   "Model": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "object": {
      "type": "string",
      "enum": [
       "model"
      ]
     },
     "created": {
      "type": "integer"
     },
     "owned_by": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "context_window": {
      "type": "integer"
     },
     "max_tokens": {
      "type": "integer"
     },
     "type": {
      "type": "string"
     },
     "tags": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "pricing": {
      "type": "object"
     }
    },
    "required": [
     "id",
     "object",
     "created",
     "owned_by"
    ]
   }
  }
 }
}
