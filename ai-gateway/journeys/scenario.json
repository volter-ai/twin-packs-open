{
  "handlers": [
    {
      "id": "briefing",
      "on": {
        "userTextIncludes": "studio briefing"
      },
      "respond": {
        "text": "Next week: two classes and one new member."
      }
    },
    {
      "id": "transient-outage",
      "on": {
        "userTextIncludes": "outage briefing"
      },
      "fault": {
        "kind": "status",
        "status": 429,
        "message": "Rate limit reached"
      },
      "once": true
    },
    {
      "id": "studio-destination",
      "on": {
        "modelEquals": "typesafe-ai/jev",
        "anyTextIncludes": "studio.example.test"
      },
      "respond": {
        "answers": {
          "isMalicious": {
            "type": "boolean",
            "probability": 0
          }
        }
      }
    },
    {
      "id": "studio-evaluation-types",
      "on": {
        "modelEquals": "typesafe-ai/jev",
        "anyTextIncludes": "rank-studio"
      },
      "respond": {
        "answers": {
          "category": {
            "type": "choice",
            "choice": "ordinary"
          },
          "rank": {
            "type": "score",
            "score": 0
          }
        }
      }
    }
  ]
}
