{
  "name": "@volter/twin-ai-gateway",
  "version": "1.0.0",
  "description": "Vercel AI Gateway twin (Protocol 3): its recorded model catalogue, OpenAI's chat completions and the AI SDK's language-model protocol on the World's scenario or the kernel wire's labeled stub (the twin runs no model), with API keys. Built on @volter/world-core.",
  "keywords": [
    "twin",
    "vercel",
    "ai-gateway",
    "llm",
    "ai-sdk"
  ],
  "author": "Volter (https://github.com/volter-ai)",
  "license": "Apache-2.0",
  "files": [
    "src",
    "journeys",
    "spec",
    "README.md",
    "LICENSE",
    "!**/*.test.ts",
    "dist",
    "generated",
    "!**/*.test.tsx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/twin-packs-open.git",
    "directory": "ai-gateway"
  },
  "homepage": "https://github.com/volter-ai/twin-packs-open/tree/main/ai-gateway#readme",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "world-ai-gateway": "dist/src/cli.js"
  },
  "peerDependencies": {
    "@volter/world-core": "*"
  },
  "engines": {
    "node": ">=22.3"
  },
  "bugs": {
    "url": "https://github.com/volter-ai/twin-packs-open/issues"
  }
}
