  {
    "title": "sync: an incremental sync that pages",
    "source": "https://developers.google.com/workspace/calendar/api/guides/sync",
    "operation": "calendar.events.list",
    "request": {
      "method": "GET",
      "url": "/calendar/v3/calendars/primary/events?maxResults=10&singleEvents=true&syncToken=CPDAlvWDx70CEPDAlvWDx"
    },
    "output": {
      "nextPageToken": "CiAKGjBpNDd2Nmp2Zml2cXRwYjBpOXA"
    },
    "placeholders": {
      "names": [
        "CPDAlvWDx70CEPDAlvWDx"
      ],
      "quote": "you need to perform a list request with your most recent sync token specified in the syncToken field"
    },
    "means": "In cases where a large number of resources have changed since the last incremental sync request, you may find a pageToken instead of a syncToken in the list result."
  },
  {
    "title": "sync: the next page of an incremental sync",
    "source": "https://developers.google.com/workspace/calendar/api/guides/sync",
    "operation": "calendar.events.list",
    "request": {
      "method": "GET",
      "url": "/calendar/v3/calendars/primary/events?maxResults=10&singleEvents=true&syncToken=CPDAlvWDx70CEPDAlvWDx&pageToken=CiAKGjBpNDd2Nmp2Zml2cXRwYjBpOXA"
    },
    "placeholders": {
      "names": [
        "CPDAlvWDx70CEPDAlvWDx",
        "CiAKGjBpNDd2Nmp2Zml2cXRwYjBpOXA"
      ],
      "quote": "with the exact same syncToken), append the pageToken to it"
    },
    "means": "In these cases you'll need to perform the exact same list query as was used for retrieval of the first page in the incremental sync (with the exact same syncToken), append the pageToken to it and paginate through all the following requests until you find another syncToken on the last page."
  },
