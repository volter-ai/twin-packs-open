{
 "vendor": "smtp",
 "author": "Contributor 68",
 "about": "Harbourline's relay for a year (journeys/customer-life.outline.md): Rallly's poll mail and Twenty's pooled invitations and a user's mailbox, sent with nodemailer through an open relay and then a locked-down one (authentication, a sender domain, a size limit), a rotated password, an oversize attachment refused, and the delivered mail read and deleted through the inspect doors.",
 "steps": [
  {
   "name": "Monday 12 January, 09:00: Wout stands up the relay, open, for the first test",
   "wait": "16380m"
  },
  {
   "name": "Wout configures the relay: its hostname, nothing else (an open relay)",
   "method": "POST",
   "path": "/_twin/relay",
   "status": 200,
   "body": {
    "hostname": "relay.harbourline.be"
   },
   "headers": {
    "content-type": "application/json"
   },
   "expect": [
    {
     "path": "auth",
     "equals": null
    }
   ]
  },
  {
   "name": "Rallly connects",
   "on": "r1",
   "connect": {},
   "expect": [
    {
     "path": "text",
     "equals": "relay.harbourline.be ESMTP"
    }
   ]
  },
  {
   "name": "EHLO: no AUTH advertised on an open relay",
   "on": "r1",
   "send": "EHLO meet.harbourline.be",
   "expect": [
    {
     "path": "lines.0",
     "equals": "relay.harbourline.be"
    },
    {
     "path": "text",
     "contains": "SIZE 10240000"
    }
   ]
  },
  {
   "name": "MAIL FROM with its size and 8BITMIME",
   "on": "r1",
   "send": "MAIL FROM:<polls@harbourline.be> SIZE=708 BODY=8BITMIME",
   "status": 250
  },
  {
   "name": "RCPT TO the first client",
   "on": "r1",
   "send": "RCPT TO:<an@veldhoven-logistics.be>",
   "status": 250,
   "expect": [
    {
     "path": "text",
     "equals": "2.1.5 Ok"
    }
   ]
  },
  {
   "name": "DATA",
   "on": "r1",
   "send": "DATA",
   "status": 354,
   "expect": [
    {
     "path": "text",
     "equals": "End data with <CR><LF>.<CR><LF>"
    }
   ]
  },
  {
   "name": "the invitation, text and HTML, then the dot",
   "on": "r1",
   "send": [
    "From: Harbourline Polls <polls@harbourline.be>",
    "To: an@veldhoven-logistics.be",
    "Subject: Harbourline workshop: pick a date",
    "Date: Mon, 12 Jan 2026 09:00:00 +0000",
    "Message-ID: <wk1@harbourline.be>",
    "MIME-Version: 1.0",
    "Content-Type: multipart/alternative; boundary=\"hl-boundary-1\"",
    "",
    "--hl-boundary-1",
    "Content-Type: text/plain; charset=utf-8",
    "Content-Transfer-Encoding: 7bit",
    "",
    "Hi,",
    "",
    "Please pick the dates that suit you: https://meet.harbourline.be/invite/wk1",
    "",
    "-- Harbourline",
    "--hl-boundary-1",
    "Content-Type: text/html; charset=utf-8",
    "Content-Transfer-Encoding: 7bit",
    "",
    "<p>Hi,</p><p>Please pick the dates that suit you: <a href=\"https://meet.harbourline.be/invite/wk1\">open the poll</a></p>",
    "--hl-boundary-1--",
    "."
   ],
   "status": 250,
   "capture": {
    "m1": "text:queued as ([A-Z]+)"
   }
  },
  {
   "name": "QUIT",
   "on": "r1",
   "send": "QUIT",
   "status": 221,
   "expect": [
    {
     "path": "text",
     "equals": "2.0.0 Bye"
    }
   ]
  },
  {
   "name": "Wout starts his HELO-only socket health monitor before relying on relay delivery",
   "on": "health",
   "connect": {}
  },
  {
   "name": "The legacy monitor identifies the box",
   "on": "health",
   "send": "HELO monitor.harbourline.be",
   "status": 250
  },
  {
   "name": "The monitor asks whether the live session is still responsive",
   "on": "health",
   "send": "NOOP",
   "status": 250,
   "expect": [
    {
     "path": "text",
     "equals": "2.0.0 Ok"
    }
   ]
  },
  {
   "name": "It probes the postmaster address: MAIL FROM",
   "on": "health",
   "send": "MAIL FROM:<monitor@harbourline.be>",
   "status": 250
  },
  {
   "name": "RCPT TO postmaster, accepted",
   "on": "health",
   "send": "RCPT TO:<postmaster@harbourline.be>",
   "status": 250
  },
  {
   "name": "and resets, sending nothing",
   "on": "health",
   "send": "RSET",
   "status": 250
  },
  {
   "name": "Then its hourly heartbeat to Wout: MAIL FROM",
   "on": "health",
   "send": "MAIL FROM:<monitor@harbourline.be>",
   "status": 250
  },
  {
   "name": "RCPT TO Wout",
   "on": "health",
   "send": "RCPT TO:<wout@harbourline.be>",
   "status": 250
  },
  {
   "name": "DATA",
   "on": "health",
   "send": "DATA",
   "status": 354
  },
  {
   "name": "the heartbeat, then the dot",
   "on": "health",
   "send": [
    "From: monitor@harbourline.be",
    "To: wout@harbourline.be",
    "Subject: relay heartbeat",
    "Date: Mon, 12 Jan 2026 09:30:00 +0000",
    "Message-ID: <hb-0930@harbourline.be>",
    "",
    "relay.harbourline.be answers.",
    "."
   ],
   "status": 250
  },
  {
   "name": "The successful health probe closes",
   "on": "health",
   "send": "QUIT",
   "status": 221
  },
  {
   "name": "Wednesday 14 January, 10:00: submission locked down",
   "wait": "2940m"
  },
  {
   "name": "Wout requires authentication, accepts only harbourline.be senders, 10 MB",
   "method": "POST",
   "path": "/_twin/relay",
   "status": 200,
   "body": {
    "hostname": "relay.harbourline.be",
    "auth": {
     "username": "relay@harbourline.be",
     "password": "tide-7291-kade"
    },
    "senderDomains": [
     "harbourline.be"
    ],
    "maxSize": 10240000
   },
   "headers": {
    "content-type": "application/json"
   },
   "expect": [
    {
     "path": "auth.username",
     "equals": "relay@harbourline.be"
    }
   ]
  },
  {
   "name": "Before handing the credentials to Rallly, Wout checks them by hand over a raw connection",
   "on": "hand",
   "connect": {}
  },
  {
   "name": "He mistypes the greeting",
   "on": "hand",
   "send": "EHOL wout-laptop",
   "status": 500
  },
  {
   "name": "and types it again",
   "on": "hand",
   "send": "EHLO wout-laptop",
   "status": 250
  },
  {
   "name": "His notes from the old mail server say CRAM-MD5, which this relay does not offer",
   "on": "hand",
   "send": "AUTH CRAM-MD5",
   "status": 504
  },
  {
   "name": "He uses LOGIN, giving the username with the command",
   "on": "hand",
   "send": "AUTH LOGIN cmVsYXlAaGFyYm91cmxpbmUuYmU=",
   "status": 334,
   "expect": [
    {
     "path": "text",
     "equals": "UGFzc3dvcmQ6"
    }
   ]
  },
  {
   "name": "then the password: the credentials work",
   "on": "hand",
   "send": "dGlkZS03MjkxLWthZGU=",
   "status": 235
  },
  {
   "name": "QUIT",
   "on": "hand",
   "send": "QUIT",
   "status": 221
  },
  {
   "name": "Rallly connects, SMTP_USER still unset",
   "on": "r2",
   "connect": {}
  },
  {
   "name": "EHLO: AUTH PLAIN LOGIN is now advertised",
   "on": "r2",
   "send": "EHLO meet.harbourline.be",
   "expect": [
    {
     "path": "text",
     "contains": "AUTH PLAIN LOGIN"
    }
