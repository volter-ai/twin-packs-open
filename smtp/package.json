{
  "name": "@volter/twin-smtp",
  "version": "1.0.2",
  "description": "Local SMTP twin (RFC 5321 submission server: EHLO/AUTH/MAIL/RCPT/DATA over raw TCP, each accepted message handed to the World twin that receives its recipient's domain, a policy door) built on @volter/world-core.",
  "author": "Volter (https://github.com/volter-ai)",
  "license": "Apache-2.0",
  "files": [
    "src",
    "journeys",
    "spec",
    "README.md",
    "LICENSE",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "dist",
    "generated"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/twin-packs-open.git",
    "directory": "smtp"
  },
  "homepage": "https://github.com/volter-ai/twin-packs-open/tree/main/smtp#readme",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "world-smtp": "./dist/src/cli.js"
  },
  "peerDependencies": {
    "@volter/world-core": "^3.0.166"
  },
  "devDependencies": {
    "@types/bun": "^1.2.20",
    "@types/node": "^24.0.0",
    "nodemailer": "^10.0.6",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.3"
  },
  "bugs": {
    "url": "https://github.com/volter-ai/twin-packs-open/issues"
  }
}
