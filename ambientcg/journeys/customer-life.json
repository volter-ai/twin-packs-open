{
  "vendor": "ambientcg",
  "author": "Contributor 81",
  "host": "ambientcg.com",
  "about": "A public, keyless catalog supplies textures and a sky to an artist using Volter Editor. Publisher doors set up the catalog only.",
  "steps": [
    {
      "name": "Publisher adds Wood 096",
      "method": "POST",
      "path": "/_twin/assets",
      "status": 201,
      "body": {
        "assetId": "Wood096",
        "dataType": "Material",
        "displayName": "Wood 096",
        "tags": [
          "wood",
          "knots",
          "beige"
        ],
        "creationMethod": "PBRPhotogrammetry",
        "releaseDate": "2026-08-23 15:00:00",
        "popularityScore": 2101,
        "downloadCount": 21,
        "downloads": [
          {
            "attribute": "1K-PNG",
            "base64": ""
          }
        ],
        "thumbnail": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGNYlaIBAALyATeJSn6HAAAAAElFTkSuQmCC"
      },
      "expect": [
        {
          "path": "assetId",
          "equals": "Wood096"
        }
      ]
    },
    {
      "name": "Publisher adds Bricks 012",
      "method": "POST",
      "path": "/_twin/assets",
      "status": 201,
      "body": {
        "assetId": "Bricks012",
        "dataType": "Material",
        "displayName": "Bricks 012",
        "tags": [
          "bricks",
          "red"
        ],
        "creationMethod": "PBRPhotogrammetry",
        "releaseDate": "2026-08-23 15:00:00",
        "popularityScore": 40,
        "downloadCount": 21,
        "downloads": [
          {
            "attribute": "1K-PNG",
            "base64": ""
          }
        ],
        "thumbnail": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGNYlaIBAALyATeJSn6HAAAAAElFTkSuQmCC"
      },
      "expect": [
        {
          "path": "assetId",
          "equals": "Bricks012"
        }
      ]
    },
    {
      "name": "Publisher adds Sky 004",
      "method": "POST",
      "path": "/_twin/assets",
      "status": 201,
      "body": {
        "assetId": "Sky004",
        "dataType": "HDRI",
        "displayName": "Sky 004",
        "tags": [
          "sky",
          "clouds"
        ],
        "creationMethod": "HDRIStitched",
        "releaseDate": "2026-08-23 15:00:00",
        "popularityScore": 500,
        "downloadCount": 21,
        "downloads": [
          {
            "attribute": "1K-HDR",
            "base64": "UEsDBBQAAAAAAABgF10Nnvc8TQAAAE0AAAARAAAAU2t5MDA0XzFLLUhEUi5oZHIjP1JBRElBTkNFCkZPUk1BVD0zMi1iaXRfcmxlX3JnYmUKCi1ZIDIgK1ggNApkjNyCeJbcgv/w0oZkjNyCUGR4gVBkeIFkbniCUGR4gVBLAQIUAxQAAAAAAABgF10Nnvc8TQAAAE0AAAARAAAAAAAAAAAAAACAAQAAAABTa3kwMDRfMUstSERSLmhkclBLBQYAAAAAAQABAD8AAAB8AAAAAAA="
          }
        ],
        "thumbnail": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGNYlaIBAALyATeJSn6HAAAAAElFTkSuQmCC"
      },
      "expect": [
        {
          "path": "assetId",
          "equals": "Sky004"
        }
      ]
    },
    {
      "name": "The artist opens the editor material library for a wooden floor",
      "method": "GET",
      "path": "/api/v2/full_json?type=Material&limit=48&offset=0&include=previewData,downloadData,tagData&sort=Popular",
      "status": 200,
      "expect": [
        {
          "path": "numberOfResults",
          "equals": 2
        },
        {
          "path": "foundAssets.0.assetId",
          "equals": "Wood096"
        },
        {
          "path": "foundAssets.1.assetId",
          "equals": "Bricks012"
        }
      ]
    },
    {
      "name": "The artist narrows the library to wood",
      "method": "GET",
      "path": "/api/v2/full_json?type=Material&limit=48&offset=0&include=previewData,downloadData,tagData&sort=Popular&q=wood",
      "status": 200,
      "capture": {
        "thumb": "foundAssets.0.previewImage.256-PNG"
      },
      "expect": [
        {
          "path": "numberOfResults",
          "equals": 1
        },
        {
          "path": "foundAssets.0.assetId",
          "equals": "Wood096"
        }
      ]
    },
    {
      "name": "The browser displays the selected wood preview",
      "method": "GET",
      "path": "{thumb}",
      "status": 200,
      "expect": []
    },
    {
      "name": "The artist works on the floor for six minutes, beyond the five-minute result-cache TTL",
      "wait": "6m"
    },
    {
      "name": "Six minutes later the editor has no retained asset-file cache and looks up the selection",
      "method": "GET",
      "path": "/api/v2/full_json?type=Material&q=Wood096&limit=1&offset=0&include=previewData,downloadData,tagData&sort=Popular",
      "status": 200,
      "capture": {
        "link": "foundAssets.0.downloadFolders.default.downloadFiletypeCategories.zip.downloads.0.downloadLink"
      },
      "expect": [
        {
          "path": "numberOfResults",
          "equals": 1
        },
        {
          "path": "foundAssets.0.assetId",
          "equals": "Wood096"
        },
        {
          "path": "foundAssets.0.downloadFolders.default.downloadFiletypeCategories.zip.downloads.0.attribute",
          "equals": "1K-PNG"
        }
      ]
    },
    {
      "name": "The import follows the returned download link",
      "method": "GET",
      "path": "{link}",
      "status": 302,
      "capture": {
        "zip": "header:location"
      },
      "expect": []
    },
    {
      "name": "The editor retrieves the texture archive for extraction",
      "method": "GET",
      "path": "{zip}",
      "status": 200,
      "expect": [
        {
          "header": "content-type",
          "equals": "application/zip"
        },
        {
          "header": "content-length",
          "equals": "615"
        },
        {
          "header": "x-bz-content-sha1",
          "equals": "743c6f45c50d5cb7607c68d8b0c9eb4a59aaf149"
        }
      ]
    },
    {
      "name": "The artist finds a sky for lighting",
      "method": "GET",
      "path": "/api/v2/full_json?type=HDRI&limit=48&offset=0&include=previewData,downloadData,tagData&sort=Popular",
      "status": 200,
      "expect": [
        {
          "path": "numberOfResults",
          "equals": 1
        },
        {
          "path": "foundAssets.0.assetId",
          "equals": "Sky004"
        }
      ]
    }
  ]
}
