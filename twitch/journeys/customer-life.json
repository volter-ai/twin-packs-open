{
 "vendor": "twitch",
 "author": "the twitch twin builder",
 "host": "api.twitch.tv",
 "about": "Aaron rehearses his AI VTuber's stream against Twitch: he signs up and registers the rig's app, the rig reads its channel through Get Started's calls, he sets the title and category in the stream manager and copies the stream key, Raiku's ears read chat anonymously over IRC on WebSocket, two viewers authorize the simulated viewers (one cancels first) and chat through the API and from the chat popout, Aaron answers from the stream manager, a token expires and is refreshed, and the sessions end. OBS's RTMP publish (going live, ending the stream) is the encoder's act, which no journey step speaks: the walk sees the channel offline throughout.",
 "steps": [
  {
   "name": "Aaron signs up as aaronvolter and registers Raiku Rig in the developer console",
   "method": "POST",
   "path": "/_twin/console",
   "body": {
    "login": "aaronvolter",
    "password": "raiku-rehearsal-1",
    "email": "aaron@volter.ai",
    "display_name": "AaronVolter",
    "application": {
     "name": "Raiku Rig",
     "redirect_uris": [
      "http://localhost:3000"
     ]
    }
   },
   "status": 200,
   "capture": {
    "clientId": "client_id",
    "clientSecret": "client_secret",
    "aaronId": "user_id"
   },
   "expect": [
    {
     "path": "login",
     "equals": "aaronvolter"
    },
    {
     "path": "client_id",
     "matches": "^[a-z0-9]{30}$"
    }
   ]
  },
  {
   "name": "Mina has a Twitch account, pixelpilgrim",
   "method": "POST",
   "path": "/_twin/accounts",
   "body": {
    "login": "pixelpilgrim",
    "password": "mina-pass-77",
    "email": "mina@pixelpilgrim.example",
    "display_name": "PixelPilgrim"
   },
   "status": 201,
   "capture": {
    "minaId": "id"
   }
  },
  {
   "name": "Lena has a Twitch account, lurkerlena",
   "method": "POST",
   "path": "/_twin/accounts",
   "body": {
    "login": "lurkerlena",
    "password": "lena-pass-42",
    "email": "lena@lurkerlena.example",
    "display_name": "LurkerLena"
   },
   "status": 201,
   "capture": {
    "lenaId": "id"
   }
  },
  {
   "name": "five minutes later",
   "wait": "5m"
  },
  {
   "name": "the rig's setup script gets an app access token with the app's client id and secret (Get Started)",
   "method": "POST",
   "path": "https://id.twitch.tv/oauth2/token",
   "headers": {
    "content-type": "application/x-www-form-urlencoded"
   },
   "body": "client_id={clientId}&client_secret={clientSecret}&grant_type=client_credentials",
   "status": 200,
   "capture": {
    "appToken": "access_token"
   },
   "expect": [
    {
     "path": "token_type",
     "equals": "bearer"
    },
    {
     "path": "expires_in",
     "equals": 5011271
    },
    {
     "path": "refresh_token",
     "exists": false
    }
   ]
  },
  {
   "name": "the setup script validates its app token: no login, no user",
   "method": "GET",
   "path": "https://id.twitch.tv/oauth2/validate",
   "headers": {
    "authorization": "OAuth {appToken}"
   },
   "status": 200,
   "expect": [
    {
     "path": "client_id",
     "equals": "{clientId}"
    },
    {
     "path": "login",
     "equals": null
    },
    {
     "path": "user_id",
     "equals": null
    },
    {
     "path": "scopes",
     "equals": []
    }
   ]
  },
  {
   "name": "the setup script reads the channel it streams to by its login",
   "method": "GET",
   "path": "/helix/users?login=aaronvolter",
   "headers": {
    "authorization": "Bearer {appToken}",
    "client-id": "{clientId}"
   },
   "status": 200,
   "expect": [
    {
     "path": "data.0.id",
     "equals": "{aaronId}"
    },
    {
     "path": "data.0.display_name",
     "equals": "AaronVolter"
    },
    {
     "path": "data.0.email",
     "exists": false
    }
   ]
  },
  {
   "name": "the setup script reads the channel's information: no title, no category yet",
   "method": "GET",
   "path": "/helix/channels?broadcaster_id={aaronId}",
   "headers": {
    "authorization": "Bearer {appToken}",
    "client-id": "{clientId}"
   },
   "status": 200,
   "expect": [
    {
     "path": "data.0.broadcaster_login",
     "equals": "aaronvolter"
    },
    {
     "path": "data.0.title",
     "equals": ""
    },
    {
     "path": "data.0.game_name",
     "equals": ""
    }
   ]
  },
  {
   "name": "the setup script asks whether the channel is live: it is offline",
   "method": "GET",
   "path": "/helix/streams?user_login=aaronvolter",
   "headers": {
    "authorization": "Bearer {appToken}",
    "client-id": "{clientId}"
   },
   "status": 200,
   "expect": [
    {
     "path": "data",
     "equals": []
    }
   ]
  },
  {
   "name": "the afternoon before the stream, 17:30",
   "wait": "1045m"
  },
  {
   "name": "Aaron opens the stream manager and is asked to log in",
   "method": "GET",
   "path": "https://dashboard.twitch.tv/u/aaronvolter/stream-manager",
   "status": 302,
   "capture": {
    "loginUrl": "header:location"
   },
   "expect": [
    {
     "header": "location",
     "contains": "https://www.twitch.tv/login?redirect="
    }
   ]
  },
  {
   "name": "the log-in page",
   "method": "GET",
   "path": "{loginUrl}",
   "status": 200,
   "expect": [
    {
     "path": "",
     "contains": "Log in to Twitch"
    }
   ]
  },
  {
   "name": "Aaron logs in and is returned to the stream manager",
   "method": "POST",
   "path": "https://www.twitch.tv/login",
   "headers": {
    "content-type": "application/x-www-form-urlencoded"
   },
   "body": "redirect=https%3A%2F%2Fdashboard.twitch.tv%2Fu%2Faaronvolter%2Fstream-manager&username=aaronvolter&password=raiku-rehearsal-1",
   "status": 302,
   "capture": {
    "aaronSession": "header:set-cookie:auth-token=([^;]+)"
   },
   "expect": [
    {
     "header": "location",
     "equals": "https://dashboard.twitch.tv/u/aaronvolter/stream-manager"
    },
    {
     "header": "set-cookie",
     "contains": "Domain=.twitch.tv"
    }
   ]
  },
  {
   "name": "the stream manager: the channel offline, Edit Stream Info empty",
   "method": "GET",
   "path": "https://dashboard.twitch.tv/u/aaronvolter/stream-manager",
   "headers": {
    "cookie": "auth-token={aaronSession}"
   },
   "status": 200,
   "expect": [
    {
     "path": "",
     "contains": "OFFLINE"
    },
    {
     "path": "",
     "contains": "Edit Stream Info"
    },
    {
     "path": "",
     "contains": "My Chat"
    }
   ]
  },
  {
   "name": "Aaron searches the categories for software",
   "method": "GET",
   "path": "https://dashboard.twitch.tv/u/aaronvolter/stream-manager?category_query=software",
   "headers": {
    "cookie": "auth-token={aaronSession}"
   },
   "status": 200,
   "capture": {
    "gameId": "text:name=\"game_id\"[^>]*value=\"(\\d+)\""
   },
   "expect": [
    {
     "path": "",
     "contains": "Software and Game Development"
    }
   ]
  },
  {
   "name": "Aaron types the title, picks Software and Game Development and clicks Done",
   "method": "POST",
   "path": "https://dashboard.twitch.tv/u/aaronvolter/stream-manager",
   "headers": {
    "content-type": "application/x-www-form-urlencoded",
    "cookie": "auth-token={aaronSession}"
   },
   "body": "title=Raiku+builds+a+cozy+farming+game%2C+day+1&game_id={gameId}&intent=save",
   "status": 303,
   "expect": [
    {
     "header": "location",
     "equals": "/u/aaronvolter/stream-manager?saved=1"
    }
   ]
  },
  {
   "name": "the stream manager shows the stream info updated",
   "method": "GET",
   "path": "https://dashboard.twitch.tv/u/aaronvolter/stream-manager?saved=1",
   "headers": {
    "cookie": "auth-token={aaronSession}"
   },
   "status": 200,
   "expect": [
    {
     "path": "",
     "contains": "Stream info updated"
    },
    {
     "path": "",
     "contains": "Raiku builds a cozy farming game, day 1"
    }
   ]
  },
  {
   "name": "Aaron opens Settings, Stream: the Primary Stream key, hidden",
   "method": "GET",
   "path": "https://dashboard.twitch.tv/u/aaronvolter/settings/stream",
   "headers": {
    "cookie": "auth-token={aaronSession}"
   },
   "status": 200,
   "expect": [
    {
     "path": "",
     "contains": "Primary Stream key"
    },
    {
     "path": "",
     "contains": "type=\"password\""
    }
   ]
  },
  {
   "name": "Aaron clicks Show and copies the key into the rig's stream-key.txt",
   "method": "GET",
   "path": "https://dashboard.twitch.tv/u/aaronvolter/settings/stream?show=1",
   "headers": {
    "cookie": "auth-token={aaronSession}"
   },
   "status": 200,
   "capture": {
    "streamKey": "text:value=\"(live_\\d+_[a-z0-9]+)\""
   },
   "expect": [
    {
     "path": "",
     "matches": "live_{aaronId}_[a-z0-9]{16}"
    }
   ]
  },
  {
   "name": "17:45",
   "wait": "15m"
  },
  {
   "name": "Raiku's ears open the chat socket, ask for tags, log in anonymously and join the channel",
   "socket": "ears",
   "open": "wss://irc-ws.chat.twitch.tv/",
   "send": [
    "CAP REQ :twitch.tv/tags",
    "PASS SCHMOOPIIE",
    "NICK justinfan48213",
    "JOIN #aaronvolter"
   ],
   "expect": [
    {
     "path": "frames.0",
     "equals": ":tmi.twitch.tv CAP * ACK :twitch.tv/tags\r\n"
    },
    {
     "path": "frames.1",
     "contains": ":tmi.twitch.tv 001 justinfan48213 :Welcome, GLHF!\r\n"
    },
    {
     "path": "frames.2",
     "contains": ":justinfan48213!justinfan48213@justinfan48213.tmi.twitch.tv JOIN #aaronvolter\r\n"
    },
    {
     "path": "frames.2",
     "contains": ":justinfan48213.tmi.twitch.tv 366 justinfan48213 #aaronvolter :End of /NAMES list\r\n"
    }
   ]
  },
  {
   "name": "18:00: OBS starts the stream (its RTMP publish is the encoder's act, outside the walk)",
   "wait": "15m"
  },
  {
   "name": "Aaron opens twitch.tv to see his channel as viewers will",
   "method": "GET",
   "path": "https://twitch.tv/",
   "headers": {
    "cookie": "auth-token={aaronSession}"
   },
   "status": 301,
   "expect": [
    {
     "header": "location",
     "equals": "https://www.twitch.tv/"
    }
   ]
  },
  {
   "name": "twitch.tv's front page sends him, logged in, to his channel",
   "method": "GET",
   "path": "https://www.twitch.tv/",
   "headers": {
    "cookie": "auth-token={aaronSession}"
   },
   "status": 302,
   "expect": [
    {
     "header": "location",
     "equals": "/aaronvolter"
    }
   ]
  },
  {
   "name": "a visitor types the channel's name with a typo, www.twitch.tv/aaronvoltre: no such channel",
   "method": "GET",
   "path": "https://www.twitch.tv/aaronvoltre",
   "status": 404,
   "expect": [
    {
     "path": "",
     "contains": "that content is unavailable"
    }
   ]
  },
  {
   "name": "a visitor types twitch.tv/aaronvolter and is moved to www.twitch.tv",
   "method": "GET",
   "path": "https://twitch.tv/aaronvolter",
   "status": 301,
   "expect": [
    {
     "header": "location",
     "equals": "https://www.twitch.tv/aaronvolter"
    }
   ]
  },
  {
   "name": "a visitor opens www.twitch.tv/aaronvolter: the title, the category, the player waiting for the broadcast, an empty chat",
   "method": "GET",
   "path": "https://www.twitch.tv/aaronvolter",
   "status": 200,
   "capture": {
    "playlist": "text:data-live-src=\"([^\"]+)\""
   },
   "expect": [
    {
     "path": "",
     "contains": "Raiku builds a cozy farming game, day 1"
    },
    {
     "path": "",
     "contains": "Software and Game Development"
    },
    {
     "path": "",
     "contains": "Stream Chat"
    },
    {
     "path": "",
     "contains": "Log In to Chat"
    }
   ]
  },
  {
   "name": "the visitor's player asks Twitch's playback host for the channel's next broadcast: none the walk published",
   "method": "GET",
   "path": "{playlist}",
   "status": 404
  },
  {
   "name": "18:10",
   "wait": "10m"
  },
  {
   "name": "the simulated viewers send Mina to authorize Raiku Rig to chat as her; she is not logged in",
   "method": "GET",
   "path": "https://id.twitch.tv/oauth2/authorize?response_type=code&client_id={clientId}&redirect_uri=http%3A%2F%2Flocalhost%3A3000&scope=user%3Awrite%3Achat&state=c3ab8aa609ea11e793ae92361f002671",
   "status": 200,
   "expect": [
    {
     "path": "",
     "contains": "Log in to Twitch"
    }
   ]
  },
  {
   "name": "Mina logs in on the page",
   "method": "POST",
   "path": "https://id.twitch.tv/oauth2/authorize",
   "headers": {
    "content-type": "application/x-www-form-urlencoded"
   },
   "body": "response_type=code&client_id={clientId}&redirect_uri=http%3A%2F%2Flocalhost%3A3000&scope=user%3Awrite%3Achat&state=c3ab8aa609ea11e793ae92361f002671&force_verify=&intent=login&username=pixelpilgrim&password=mina-pass-77",
   "status": 302,
   "capture": {
    "minaSession": "header:set-cookie:auth-token=([^;]+)",
    "minaAuthorize": "header:location"
   }
  },
  {
   "name": "the page asks Mina to authorize Raiku Rig to send chat messages",
   "method": "GET",
   "path": "https://id.twitch.tv{minaAuthorize}",
   "headers": {
    "cookie": "auth-token={minaSession}"
   },
   "status": 200,
   "expect": [
    {
     "path": "",
     "contains": "Authorize Raiku Rig"
    },
    {
     "path": "",
     "contains": "Send chat messages to a chatroom."
    },
    {
     "path": "",
     "contains": "AaronVolter"
    }
   ]
  },
  {
   "name": "Mina clicks Authorize and her browser is sent to the program with a code",
   "method": "POST",
   "path": "https://id.twitch.tv/oauth2/authorize",
   "headers": {
    "content-type": "application/x-www-form-urlencoded",
    "cookie": "auth-token={minaSession}"
   },
   "body": "response_type=code&client_id={clientId}&redirect_uri=http%3A%2F%2Flocalhost%3A3000&scope=user%3Awrite%3Achat&state=c3ab8aa609ea11e793ae92361f002671&force_verify=&intent=authorize",
   "status": 302,
   "capture": {
    "minaCode": "header:location:code=([a-z0-9]+)"
   },
   "expect": [
    {
     "header": "location",
     "matches": "^http://localhost:3000/\\?code=[a-z0-9]{30}&scope=user%3Awrite%3Achat&state=c3ab8aa609ea11e793ae92361f002671$"
    }
   ]
  },
  {
   "name": "the program trades Mina's code for her tokens",
   "method": "POST",
   "path": "https://id.twitch.tv/oauth2/token",
   "headers": {
    "content-type": "application/x-www-form-urlencoded"
   },
   "body": "client_id={clientId}&client_secret={clientSecret}&code={minaCode}&grant_type=authorization_code&redirect_uri=http%3A%2F%2Flocalhost%3A3000",
   "status": 200,
   "capture": {
    "minaToken": "access_token",
    "minaRefresh": "refresh_token"
   },
   "expect": [
    {
     "path": "scope",
     "equals": [
      "user:write:chat"
     ]
    },
    {
     "path": "expires_in",
     "equals": 14124
    },
    {
     "path": "token_type",
     "equals": "bearer"
    }
   ]
  },
  {
   "name": "the program validates Mina's token as it starts",
   "method": "GET",
   "path": "https://id.twitch.tv/oauth2/validate",
   "headers": {
    "authorization": "OAuth {minaToken}"
   },
   "status": 200,
   "expect": [
    {
     "path": "login",
     "equals": "pixelpilgrim"
    },
    {
     "path": "user_id",
     "equals": "{minaId}"
    },
    {
     "path": "scopes",
     "equals": [
      "user:write:chat"
     ]
    },
    {
     "path": "expires_in",
     "equals": 14124
    }
   ],
   "capture": {
    "minaUser": "user_id"
   }
  },
  {
   "name": "the program looks up the broadcaster's id by login",
   "method": "GET",
   "path": "/helix/users?login=aaronvolter",
   "headers": {
    "authorization": "Bearer {minaToken}",
    "client-id": "{clientId}"
   },
   "status": 200,
   "expect": [
    {
     "path": "data.0.id",
     "equals": "{aaronId}"
    }
   ]
  },
  {
   "name": "Mina says hi in aaronvolter's chat",
   "method": "POST",
   "path": "/helix/chat/messages",
   "headers": {
    "authorization": "Bearer {minaToken}",
    "client-id": "{clientId}"
   },
   "body": {
    "broadcaster_id": "{aaronId}",
    "sender_id": "{minaUser}",
    "message": "hi Raiku! what are we building today?"
   },
   "status": 200,
   "capture": {
    "minaHi": "data.0.message_id"
   },
   "expect": [
    {
     "path": "data.0.is_sent",
     "equals": true
    }
   ]
  },
  {
   "name": "Raiku's ears hear it as a tagged PRIVMSG from PixelPilgrim",
   "socket": "ears",
   "expect": [
    {
     "path": "frames.0",
     "contains": "display-name=PixelPilgrim;"
    },
    {
     "path": "frames.0",
     "contains": ";id={minaHi};"
    },
    {
     "path": "frames.0",
     "contains": ";first-msg=1;"
    },
    {
     "path": "frames.0",
     "contains": " :pixelpilgrim!pixelpilgrim@pixelpilgrim.tmi.twitch.tv PRIVMSG #aaronvolter :hi Raiku! what are we building today?\r\n"
    }
   ]
  },
  {
   "name": "the visitor's open channel page asks for the chat's new messages and shows Mina's",
   "method": "GET",
   "path": "https://www.twitch.tv/aaronvolter?live=chat&after=",
   "status": 200,
   "expect": [
    {
     "path": "",
     "contains": "hi Raiku! what are we building today?"
    },
    {
     "header": "x-live-cursor",
     "equals": "{minaHi}"
    }
   ]
  },
  {
   "name": "18:20",
   "wait": "10m"
  },
  {
   "name": "the simulated viewers send Lena to authorize Raiku Rig; she is not logged in",
   "method": "GET",
   "path": "https://id.twitch.tv/oauth2/authorize?response_type=code&client_id={clientId}&redirect_uri=http%3A%2F%2Flocalhost%3A3000&scope=user%3Awrite%3Achat&state=9b1deb4d3b7d4bad9bdd2b0d7b3dcb6d",
   "status": 200,
   "expect": [
    {
     "path": "",
     "contains": "Log in to Twitch"
    }
   ]
  },
  {
   "name": "Lena logs in on the page",
   "method": "POST",
   "path": "https://id.twitch.tv/oauth2/authorize",
   "headers": {
    "content-type": "application/x-www-form-urlencoded"
   },
   "body": "response_type=code&client_id={clientId}&redirect_uri=http%3A%2F%2Flocalhost%3A3000&scope=user%3Awrite%3Achat&state=9b1deb4d3b7d4bad9bdd2b0d7b3dcb6d&force_verify=&intent=login&username=lurkerlena&password=lena-pass-42",
   "status": 302,
   "capture": {
    "lenaSession": "header:set-cookie:auth-token=([^;]+)",
    "lenaAuthorize": "header:location"
   }
  },
  {
   "name": "the page asks Lena to authorize Raiku Rig",
   "method": "GET",
   "path": "https://id.twitch.tv{lenaAuthorize}",
   "headers": {
    "cookie": "auth-token={lenaSession}"
   },
   "status": 200,
   "expect": [
    {
     "path": "",
     "contains": "Authorize Raiku Rig"
    }
   ]
  },
  {
   "name": "Lena is not ready to let a program chat as her and clicks Cancel",
   "method": "POST",
   "path": "https://id.twitch.tv/oauth2/authorize",
   "headers": {
    "content-type": "application/x-www-form-urlencoded",
    "cookie": "auth-token={lenaSession}"
   },
   "body": "response_type=code&client_id={clientId}&redirect_uri=http%3A%2F%2Flocalhost%3A3000&scope=user%3Awrite%3Achat&state=9b1deb4d3b7d4bad9bdd2b0d7b3dcb6d&force_verify=&intent=cancel",
   "status": 302,
   "expect": [
    {
     "header": "location",
     "equals": "http://localhost:3000/?error=access_denied&error_description=The+user+denied+you+access&state=9b1deb4d3b7d4bad9bdd2b0d7b3dcb6d"
    }
   ]
  },
  {
   "name": "19:10, an hour after Mina authorized",
   "wait": "50m"
  },
  {
   "name": "the program's hourly validation finds Mina's token still valid",
   "method": "GET",
   "path": "https://id.twitch.tv/oauth2/validate",
   "headers": {
    "authorization": "OAuth {minaToken}"
   },
   "status": 200,
   "expect": [
    {
     "path": "expires_in",
     "equals": 10524
    }
   ]
  },
  {
   "name": "19:20: Lena has watched for an hour",
   "wait": "10m"
  },
  {
   "name": "Lena opens the link again; still logged in, she sees the consent at once",
   "method": "GET",
   "path": "https://id.twitch.tv/oauth2/authorize?response_type=code&client_id={clientId}&redirect_uri=http%3A%2F%2Flocalhost%3A3000&scope=user%3Awrite%3Achat&state=1f0e3dad99908345f7439f8ffabdffc4",
   "headers": {
    "cookie": "auth-token={lenaSession}"
   },
   "status": 200,
   "expect": [
    {
     "path": "",
     "contains": "Authorize Raiku Rig"
    },
    {
     "path": "",
     "contains": "LurkerLena"
    }
   ]
  },
  {
   "name": "Lena clicks Authorize",
   "method": "POST",
   "path": "https://id.twitch.tv/oauth2/authorize",
   "headers": {
    "content-type": "application/x-www-form-urlencoded",
    "cookie": "auth-token={lenaSession}"
   },
   "body": "response_type=code&client_id={clientId}&redirect_uri=http%3A%2F%2Flocalhost%3A3000&scope=user%3Awrite%3Achat&state=1f0e3dad99908345f7439f8ffabdffc4&force_verify=&intent=authorize",
   "status": 302,
   "capture": {
    "lenaCode": "header:location:code=([a-z0-9]+)"
   }
  },
  {
   "name": "the program trades Lena's code for her tokens",
   "method": "POST",
   "path": "https://id.twitch.tv/oauth2/token",
   "headers": {
    "content-type": "application/x-www-form-urlencoded"
   },
   "body": "client_id={clientId}&client_secret={clientSecret}&code={lenaCode}&grant_type=authorization_code&redirect_uri=http%3A%2F%2Flocalhost%3A3000",
   "status": 200,
   "capture": {
    "lenaToken": "access_token"
   }
  },
  {
   "name": "the program validates Lena's token",
   "method": "GET",
   "path": "https://id.twitch.tv/oauth2/validate",
   "headers": {
    "authorization": "OAuth {lenaToken}"
   },
   "status": 200,
   "expect": [
    {
     "path": "login",
     "equals": "lurkerlena"
    },
    {
     "path": "user_id",
     "equals": "{lenaId}"
    }
   ],
   "capture": {
    "lenaUser": "user_id"
   }
  },
  {
   "name": "the program sends Lena's first line, as her",
   "method": "POST",
   "path": "/helix/chat/messages",
   "headers": {
    "authorization": "Bearer {lenaToken}",
    "client-id": "{clientId}"
   },
   "body": {
    "broadcaster_id": "{aaronId}",
    "sender_id": "{lenaUser}",
    "message": "first time here, love the avatar"
   },
   "status": 200,
   "expect": [
    {
     "path": "data.0.is_sent",
     "equals": true
    }
   ]
  },
  {
   "name": "Raiku's ears hear Lena's first message",
   "socket": "ears",
   "expect": [
    {
     "path": "frames.0",
     "contains": "display-name=LurkerLena;"
    },
    {
     "path": "frames.0",
     "contains": ";first-msg=1;"
    },
    {
     "path": "frames.0",
     "contains": " :lurkerlena!lurkerlena@lurkerlena.tmi.twitch.tv PRIVMSG #aaronvolter :first time here, love the avatar\r\n"
    }
   ]
  },
  {
   "name": "19:30",
   "wait": "10m"
  },
  {
   "name": "Aaron answers Mina from the stream manager's chat",
   "method": "POST",
   "path": "https://dashboard.twitch.tv/u/aaronvolter/stream-manager",
   "headers": {
    "content-type": "application/x-www-form-urlencoded",
    "cookie": "auth-token={aaronSession}"
   },
   "body": "message=welcome+Mina%21+a+cozy+farming+game+in+Godot&intent=chat",
   "status": 303,
   "expect": [
    {
     "header": "location",
     "equals": "/u/aaronvolter/stream-manager"
    }
   ]
  },
  {
   "name": "Raiku's ears hear Aaron with the broadcaster's badge",
   "socket": "ears",
   "expect": [
    {
     "path": "frames.0",
     "contains": "@badge-info=;badges=broadcaster/1;"
    },
    {
     "path": "frames.0",
     "contains": "display-name=AaronVolter;"
    },
    {
     "path": "frames.0",
     "contains": " :aaronvolter!aaronvolter@aaronvolter.tmi.twitch.tv PRIVMSG #aaronvolter :welcome Mina! a cozy farming game in Godot\r\n"
    }
   ]
  },
  {
   "name": "Lena, logged in at twitch.tv since she authorized, opens the channel's chat popout",
   "method": "GET",
   "path": "https://www.twitch.tv/popout/aaronvolter/chat?popout=",
   "headers": {
    "cookie": "auth-token={lenaSession}"
   },
   "status": 200,
   "expect": [
    {
     "path": "",
     "contains": "Send a message"
    },
    {
     "path": "",
     "contains": "welcome Mina! a cozy farming game in Godot"
    },
    {
     "path": "",
     "contains": "first time here, love the avatar"
    }
   ]
  },
  {
   "name": "Lena writes in the popout",
   "method": "POST",
   "path": "https://www.twitch.tv/popout/aaronvolter/chat?popout=",
   "headers": {
    "content-type": "application/x-www-form-urlencoded",
    "cookie": "auth-token={lenaSession}"
   },
   "body": "message=the+chickens+are+adorable&intent=chat",
   "status": 303,
   "expect": [
    {
     "header": "location",
     "equals": "/popout/aaronvolter/chat?popout="
    }
   ]
  },
  {
   "name": "Raiku's ears hear Lena's second message",
   "socket": "ears",
   "expect": [
    {
     "path": "frames.0",
     "contains": "display-name=LurkerLena;"
    },
    {
     "path": "frames.0",
     "contains": ";first-msg=0;"
    },
    {
     "path": "frames.0",
     "contains": " :lurkerlena!lurkerlena@lurkerlena.tmi.twitch.tv PRIVMSG #aaronvolter :the chickens are adorable\r\n"
    }
   ]
  },
  {
   "name": "Mina, logged in at twitch.tv since she authorized, opens the channel page herself and asks in its chat",
   "method": "POST",
   "path": "https://www.twitch.tv/aaronvolter",
   "headers": {
    "content-type": "application/x-www-form-urlencoded",
    "cookie": "auth-token={minaSession}"
   },
   "body": "message=is+it+Godot+or+Unity%3F&intent=chat",
   "status": 303,
   "expect": [
    {
     "header": "location",
     "equals": "/aaronvolter"
    }
   ]
  },
  {
   "name": "Raiku's ears hear Mina's question",
   "socket": "ears",
   "expect": [
    {
     "path": "frames.0",
     "contains": ";first-msg=0;"
    },
    {
     "path": "frames.0",
     "contains": " :pixelpilgrim!pixelpilgrim@pixelpilgrim.tmi.twitch.tv PRIVMSG #aaronvolter :is it Godot or Unity?\r\n"
    }
   ]
  },
  {
   "name": "22:10, four hours after Mina authorized",
   "wait": "160m"
  },
  {
   "name": "the program's hourly validation finds Mina's token no longer valid, four hours after she authorized",
   "method": "GET",
   "path": "https://id.twitch.tv/oauth2/validate",
   "headers": {
    "authorization": "OAuth {minaToken}"
   },
   "status": 401,
   "expect": [
    {
     "path": "status",
     "equals": 401
    },
    {
     "path": "message",
     "equals": "invalid access token"
    }
   ]
  },
  {
   "name": "the program trades Mina's refresh token for a new access token",
   "method": "POST",
   "path": "https://id.twitch.tv/oauth2/token",
   "headers": {
    "content-type": "application/x-www-form-urlencoded"
   },
   "body": "grant_type=refresh_token&refresh_token={encoded:minaRefresh}&client_id={clientId}&client_secret={clientSecret}",
   "status": 200,
   "capture": {
    "minaToken2": "access_token"
   },
   "expect": [
    {
     "path": "refresh_token",
     "equals": "{minaRefresh}"
    },
    {
     "path": "scope",
     "equals": [
      "user:write:chat"
     ]
    }
   ]
  },
  {
   "name": "22:30, the end of the stream",
   "wait": "20m"
  },
  {
   "name": "Mina signs off in chat",
   "method": "POST",
   "path": "/helix/chat/messages",
   "headers": {
    "authorization": "Bearer {minaToken2}",
    "client-id": "{clientId}"
   },
   "body": {
    "broadcaster_id": "{aaronId}",
    "sender_id": "{minaUser}",
    "message": "gg, see you tomorrow"
   },
   "status": 200,
   "expect": [
    {
     "path": "data.0.is_sent",
     "equals": true
    }
   ]
  },
  {
   "name": "Raiku's ears hear it, Mina's third message, and leave the channel as Aaron stops the stream",
   "socket": "ears",
   "send": "PART #aaronvolter",
   "expect": [
    {
     "path": "frames.0",
     "contains": ";first-msg=0;"
    },
    {
     "path": "frames.0",
     "contains": "PRIVMSG #aaronvolter :gg, see you tomorrow\r\n"
    },
    {
     "path": "frames.1",
     "equals": ":justinfan48213!justinfan48213@justinfan48213.tmi.twitch.tv PART #aaronvolter\r\n"
    }
   ]
  },
  {
   "name": "Raiku's ears hang up",
   "socket": "ears",
   "close": true,
   "status": 1000
  },
  {
   "name": "22:45",
   "wait": "15m"
  },
  {
   "name": "the rehearsal over, the program ends Mina's session",
   "method": "POST",
   "path": "https://id.twitch.tv/oauth2/revoke",
   "headers": {
    "content-type": "application/x-www-form-urlencoded"
   },
   "body": "client_id={clientId}&token={minaToken2}",
   "status": 200
  },
  {
   "name": "and Lena's",
   "method": "POST",
   "path": "https://id.twitch.tv/oauth2/revoke",
   "headers": {
    "content-type": "application/x-www-form-urlencoded"
   },
   "body": "client_id={clientId}&token={lenaToken}",
   "status": 200
  },
  {
   "name": "the program checks that Mina's revoked token no longer validates before it exits",
   "method": "GET",
   "path": "https://id.twitch.tv/oauth2/validate",
   "headers": {
    "authorization": "OAuth {minaToken2}"
   },
   "status": 401,
   "expect": [
    {
     "path": "message",
     "equals": "invalid access token"
    }
   ]
  },
  {
   "name": "Friday 2 January, 09:00",
   "wait": "615m"
  },
  {
   "name": "the setup script, still holding its app token, reads the channel the stream left: its title and category",
   "method": "GET",
   "path": "/helix/channels?broadcaster_id={aaronId}",
   "headers": {
    "authorization": "Bearer {appToken}",
    "client-id": "{clientId}"
   },
   "status": 200,
   "expect": [
    {
     "path": "data.0.title",
     "equals": "Raiku builds a cozy farming game, day 1"
    },
    {
     "path": "data.0.game_id",
     "equals": "{gameId}"
    },
    {
     "path": "data.0.game_name",
     "equals": "Software and Game Development"
    }
   ]
  }
 ]
}
