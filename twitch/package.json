{
  "name": "@volter/twin-twitch",
  "version": "1.0.0",
  "description": "Local Twitch twin: twitch.tv's channel page (a LivePlayer playing the broadcast OBS streams in over RTMP, its live chat, viewers, title and category), chat popout, log-in and creator dashboard (stream manager, stream key); chat over IRC on WebSocket; id.twitch.tv's OAuth (authorize page, token, validate, revoke) and the Helix calls those need (users, channels, streams, stream key, categories, Send Chat Message), built on @volter/world-core's live media.",
  "author": "Volter (https://github.com/volter-ai)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "world-twitch": "dist/src/cli.js"
  },
  "files": [
    "src",
    "id",
    "journeys",
    "spec",
    "README.md",
    "LICENSE",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "dist",
    "generated",
    "!spec/doc-examples.json",
    "!id/spec/doc-examples.json",
    "!journeys/vendor-examples.json",
    "!dist/spec/doc-examples.json",
    "!dist/id/spec/doc-examples.json",
    "!dist/journeys/vendor-examples.json"
  ],
  "peerDependencies": {
    "@volter/world-core": "^3.0.155"
  },
  "engines": {
    "node": ">=22.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/twin-packs-open.git",
    "directory": "twitch"
  },
  "homepage": "https://github.com/volter-ai/twin-packs-open/tree/main/twitch#readme",
  "dependencies": {
    "@volter/world-ui": "^1.0.155",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/bun": "^1.2.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "fixtures",
    "hls",
    "irc",
    "live",
    "local",
    "mirror",
    "mock",
    "oauth",
    "obs",
    "rtmp",
    "simulator",
    "streaming",
    "testing",
    "twin",
    "twitch"
  ],
  "bugs": {
    "url": "https://github.com/volter-ai/twin-packs-open/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
