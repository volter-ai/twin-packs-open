   "path": "/api/v2/search",
   "headers": {
    "authorization": "Bearer {key}",
    "content-type": "application/json"
   },
   "body": {
    "sourceId": "{traces}",
    "startTime": "2026-01-05T09:00:00Z",
    "endTime": "2026-01-05T11:00:00Z",
    "where": "ServiceName:librechat AND Duration:>800000000",
