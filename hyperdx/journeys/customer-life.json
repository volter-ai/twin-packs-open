   },
   "status": 200,
   "expect": [
    {
     "path": "rows",
     "equals": 2
    },
    {
     "path": "data.0",
     "equals": {
      "Timestamp": "2026-01-05T10:00:00.120000000Z",
      "SpanId": "b7ad6b7169203331",
      "ParentSpanId": "00f067aa0ba902b7",
      "SpanName": "mongodb.insert",
      "SpanKind": "Client",
      "Duration": "715000000",
      "StatusCode": "Error",
      "StatusMessage": "connection 4 to 127.0.0.1:27017 closed"
     }
    },
    {
     "path": "data.1.SpanName",
     "equals": "POST /api/*"
    },
    {
     "path": "data.1.ParentSpanId",
     "equals": ""
    },
    {
     "path": "data.1.SpanKind",
     "equals": "Server"
    },
    {
     "path": "data.1.Duration",
