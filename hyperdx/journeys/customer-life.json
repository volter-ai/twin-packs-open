    }
   ],
   "body": "{\"sourceId\":\"{traces}\",\"where\":\"TraceId:4bf92f3577b34da6a3ce929d0e0e4736\",}"
  },
  {
   "name": "The failed request's trace by its TraceId, newest span first: the retried export kept each span once",
   "method": "POST",
   "path": "/api/v2/search",
   "headers": {
    "authorization": "Bearer {key}",
    "content-type": "application/json"
   },
   "body": {
    "sourceId": "{traces}",
    "startTime": "2026-01-05T09:00:00Z",
    "endTime": "2026-01-05T11:00:00Z",
    "where": "TraceId:4bf92f3577b34da6a3ce929d0e0e4736",
