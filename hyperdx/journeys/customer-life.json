    "authorization": "Bearer {key}"
   },
   "status": 200,
   "expect": [
    {
     "path": "data.id",
     "equals": "{traces}"
    },
    {
     "path": "data.durationExpression",
     "equals": "Duration"
    },
    {
     "path": "data.durationPrecision",
     "equals": 9
    },
    {
     "path": "data.logSourceId",
     "equals": "{logs}"
    }
   ]
  },
  {
   "name": "A source id the team does not hold is not found",
   "method": "GET",
   "path": "/api/v2/sources/507f1f77bcf86cd799439011",
   "headers": {
    "authorization": "Bearer {key}"
   },
   "status": 404,
