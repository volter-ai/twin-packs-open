         "key": "service.name",
         "value": {
          "stringValue": "librechat-web"
         }
        },
        {
         "key": "telemetry.sdk.name",
         "value": {
          "stringValue": "opentelemetry"
         }
        },
        {
         "key": "rum.sessionId",
         "value": {
          "stringValue": "6a1f2d0c9b8e4f3a"
         }
        }
       ]
      },
      "scopeSpans": [
       {
        "scope": {
         "name": "@hyperdx/instrumentation-fetch",
         "version": "0.18.0"
        },
        "spans": [
         {
          "traceId": "9e1c7b2a4d6f48a0b3c5d7e9f1a2b4c6",
          "spanId": "1a2b3c4d5e6f7a8b",
          "name": "HTTP GET",
          "kind": 3,
          "startTimeUnixNano": "1767607199500000000",
          "endTimeUnixNano": "1767607199532000000",
          "attributes": [
           {
            "key": "http.method",
            "value": {
             "stringValue": "GET"
            }
           },
           {
            "key": "http.url",
