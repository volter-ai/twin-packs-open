    }
   ],
   "evidence": "https://raw.githubusercontent.com/hyperdxio/hyperdx/049ec84245d4e0572a6301b2179265fbbbb344e3/packages/api/src/routers/external-api/v2/search.ts"
  },
  {
   "name": "The exception the server span recorded, read from its events",
   "method": "POST",
   "path": "/api/v2/search",
   "headers": {
    "authorization": "Bearer {key}",
    "content-type": "application/json"
   },
   "body": {
    "sourceId": "{traces}",
    "startTime": "2026-01-05T09:00:00Z",
    "endTime": "2026-01-05T11:00:00Z",
    "where": "TraceId:4bf92f3577b34da6a3ce929d0e0e4736 AND SpanKind:\"Server\"",
    "select": "Events.Name,Events.Attributes"
   },
   "status": 200,
   "expect": [
    {
     "path": "rows",
     "equals": 1
    },
    {
     "path": "data.0",
     "equals": {
      "Events.Name": [
       "exception"
      ],
      "Events.Attributes": [
       {
        "exception.type": "MongoNetworkError",
        "exception.message": "connection 4 to 127.0.0.1:27017 closed",
        "exception.stacktrace": "MongoNetworkError: connection 4 to 127.0.0.1:27017 closed\n    at Connection.onClose (node_modules/mongodb/lib/cmap/connection.js:283:21)\n    at saveMessage (api/models/Message.js:61:17)"
       }
      ]
     }
    }
   ]
  },
  {
   "name": "Slow spans asked as Duration:>1s: Duration is a count of nanoseconds, and ClickHouse cannot read 1s as one",
   "method": "POST",
   "path": "/api/v2/search",
   "headers": {
    "authorization": "Bearer {key}",
    "content-type": "application/json"
   },
   "body": {
    "sourceId": "{traces}",
    "startTime": "2026-01-05T09:00:00Z",
    "endTime": "2026-01-05T11:00:00Z",
    "where": "ServiceName:librechat AND Duration:>1s"
   },
   "status": 500,
   "expect": [
    {
     "path": "message",
     "equals": "Query execution failed"
    }
   ]
  },
  {
   "name": "LibreChat's slow spans: ServiceName:librechat AND Duration:>800000000 (over 800 ms); the browser's 32 ms span names librechat-web and is not slow",
