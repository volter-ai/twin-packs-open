   "evidence": "Twenty packages/twenty-server/src/instrument.ts:158"
  },
  {
   "name": "10:05: the on-call engineer opens HyperDX's External API to look at the failure",
   "wait": "10m"
  },
  {
   "name": "Without a key, the API refuses before it reads anything",
   "method": "GET",
   "path": "/api/v2/sources",
   "status": 401,
   "expect": [
    {
     "path": "",
     "equals": "Unauthorized"
    }
   ],
   "evidence": "https://raw.githubusercontent.com/hyperdxio/hyperdx/049ec84245d4e0572a6301b2179265fbbbb344e3/packages/api/src/routers/external-api/v2/index.ts"
  },
  {
   "name": "The team's sources: Logs and Traces, as HyperDX sets a team up",
   "method": "GET",
   "path": "/api/v2/sources",
   "headers": {
    "authorization": "Bearer {key}"
   },
   "status": 200,
   "capture": {
    "logs": "data.0.id",
    "traces": "data.1.id"
   },
   "expect": [
    {
     "path": "data.0.name",
     "equals": "Logs"
    },
    {
     "path": "data.0.kind",
     "equals": "log"
    },
    {
     "path": "data.0.id",
     "matches": "^[0-9a-f]{24}$"
    },
    {
     "path": "data.0.from",
     "equals": {
      "databaseName": "default",
      "tableName": "otel_logs"
     }
    },
    {
     "path": "data.0.defaultTableSelectExpression",
     "equals": "Timestamp,ServiceName,SeverityText,Body"
    },
    {
     "path": "data.1.name",
     "equals": "Traces"
    },
    {
     "path": "data.1.kind",
     "equals": "trace"
    },
    {
     "path": "data.1.implicitColumnExpression",
     "equals": "SpanName"
    },
    {
     "path": "data.2",
     "exists": false
    }
   ],
   "evidence": "https://raw.githubusercontent.com/hyperdxio/hyperdx/049ec84245d4e0572a6301b2179265fbbbb344e3/packages/api/src/routers/external-api/v2/sources.ts"
  },
  {
