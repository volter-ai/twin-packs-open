             "stringValue": "https://chat.kestrel.test/api/config"
            }
           },
           {
            "key": "http.status_code",
            "value": {
             "intValue": "200"
            }
           }
          ],
          "status": {}
         }
        ]
       }
      ]
     }
    ]
   },
   "status": 200,
   "expect": [
    {
     "header": "content-type",
     "contains": "application/json"
    },
    {
     "path": "partialSuccess",
     "exists": false
    }
   ],
   "evidence": "LibreChat client/src/lib/rum/useRum.ts:214; @hyperdx/otel-web@0.18.0:dist/cjs/index.js:73"
  },
  {
   "name": "10:00: LibreChat's NodeSDK exports the failed POST /api/* trace (binary protobuf): the server span (an exception event, status error, 850 ms) and its MongoDB insert child (715 ms)",
   "method": "POST",
   "path": "/v1/traces",
   "headers": {
    "content-type": "application/x-protobuf"
   },
   "bodyBase64": "",
   "status": 200,
   "expect": [
    {
     "header": "content-type",
     "equals": "application/x-protobuf"
    },
    {
     "path": "",
     "equals": ""
    }
   ],
   "evidence": "LibreChat packages/api/src/telemetry/sdk.ts:356; @opentelemetry/exporter-trace-otlp-proto@0.218.0:build/src/platform/node/OTLPTraceExporter.js:17"
  },
  {
