{
  "handlers": [
    {
      "on": {
        "hasTool": "list_files",
        "lastMessageIsToolResult": false
      },
      "respond": {
        "toolCalls": [
          {
            "name": "list_files",
            "arguments": {
              "path": "src"
            }
          }
        ]
      }
    },
    {
      "on": {
        "hasTool": "Read",
        "lastMessageIsToolResult": false
      },
      "respond": {
        "toolCalls": [
          {
            "name": "Read",
            "arguments": {
              "file_path": "src/scene.json"
            }
          }
        ]
      }
    },
    {
      "on": {
        "hasTool": "shell",
        "lastMessageIsToolResult": false
      },
      "respond": {
        "toolCalls": [
          {
            "name": "shell",
            "arguments": {
              "command": "npm test"
            }
          }
        ]
      }
    },
    {
      "on": {
        "operationEquals": "sendChatCompletionRequest",
        "lastMessageIsToolResult": true
      },
      "respond": {
        "text": "The supplied directory listing contains scene.json and player.ts."
      }
    },
    {
      "on": {
        "operationEquals": "createMessages",
        "lastMessageIsToolResult": true
      },
      "respond": {
        "text": "The supplied scene content names hero.png as the player sprite."
      }
    },
    {
      "on": {
        "operationEquals": "createResponses",
        "lastMessageIsToolResult": true
      },
      "respond": {
        "text": "The supplied scene tests report 12 passed."
      }
    }
  ]
}
