  "license": "Apache-2.0",
  "files": [
    "dist",
    "generated",
    "src",
    "spec",
    "journeys",
    "README.md",
    "LICENSE",
    "!**/*.test.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/twin-packs-open.git",
    "directory": "openrouter"
  },
  "homepage": "https://github.com/volter-ai/twin-packs-open/tree/main/openrouter#readme",
