        "userTextIncludes": "server fault fixture"
      },
      "fault": {
        "kind": "status",
        "status": 500
      }
    },
    {
      "id": "overload-fixture",
      "on": {
        "userTextIncludes": "overload fixture"
      },
      "fault": {
        "kind": "status",
        "status": 503
      }
    },
    {
      "id": "quota-fixture",
      "on": {
        "userTextIncludes": "quota fixture"
      },
      "fault": {
        "kind": "status",
        "status": 429
      }
    },
    {
      "id": "offered-light-call",
      "on": {
        "hasTool": "enable_lights"
      },
      "respond": {
        "functionCalls": [
          {
            "name": "enable_lights",
            "args": {}
          }
        ]
      }
    },
    {
      "id": "prompt-feedback",
      "on": {
        "userTextIncludes": "blocked prompt fixture"
      },
      "respond": {
        "promptFeedback": {
          "blockReason": "SAFETY",
          "safetyRatings": [
            {
              "category": "HARM_CATEGORY_HATE_SPEECH",
              "probability": "HIGH"
            }
          ]
        }
      }
    },
    {
      "id": "medium-safety",
      "on": {
        "userTextIncludes": "including expletives"
      },
      "respond": {
        "text": "A scripted rivalry phrase.",
        "safetyRatings": [
          {
            "category": "HARM_CATEGORY_HATE_SPEECH",
            "probability": "MEDIUM"
          },
          {
            "category": "HARM_CATEGORY_HARASSMENT",
            "probability": "LOW"
          }
        ]
      }
    },
    {
      "id": "cat-instruction",
      "on": {
        "anyTextIncludes": "You are a cat. Your name is Neko."
      },
      "respond": {
        "text": "[twin-stub] Neko the cat says hello."
      }
    },
    {
      "id": "arithmetic",
      "on": {
        "hasTool": "multiplyNumbers",
        "userTextIncludes": "57 cats"
      },
      "respond": {
        "functionCalls": [
          {
            "name": "multiplyNumbers",
            "args": {
              "firstParam": 57,
              "secondParam": 44
            }
          }
        ]
      }
    },
    {
      "id": "stop-fixture",
      "on": {
        "userTextIncludes": "Explain how AI works",
        "generationConfigEquals": {
          "stopSequences": [
            "Title"
          ],
          "temperature": 1.0,
          "maxOutputTokens": 800,
          "topP": 0.8,
          "topK": 10
        }
      },
      "respond": {
        "text": "A synthetic explanation. Title This heading is beyond the stop sequence."
      }
    },
    {
      "id": "safety-fixture",
      "on": {
        "userTextIncludes": "Martians Soccer Club"
      },
      "respond": {
        "text": "[twin-stub] A synthetic sporting rivalry reply.",
        "safetyRatings": [
          {
            "category": "HARM_CATEGORY_HARASSMENT",
            "probability": "LOW"
          },
          {
            "category": "HARM_CATEGORY_HATE_SPEECH",
            "probability": "LOW"
          }
        ]
      }
    }
  ]
}
