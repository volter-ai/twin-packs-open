      "method": "POST",
      "path": "https://us.i.posthog.com/i/v0/e/",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "api_key": "{token}",
        "event": "event_name",
        "distinct_id": "distinct_id",
        "properties": {
          "$set": {
            "email": "unset@example.test",
