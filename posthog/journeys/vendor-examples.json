          }
        }
      },
      "expect": [
        {
          "path": "status",
          "equals": "Ok"
        }
      ]
    },
    {
      "name": "The published unset example removes the email",
      "method": "POST",
      "path": "https://us.i.posthog.com/i/v0/e/",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "distinct_id": "distinct_id",
        "event": "event_name",
        "properties": {
          "$unset": [
            "email"
