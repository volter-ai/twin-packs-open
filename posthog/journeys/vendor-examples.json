      "path": "https://us.posthog.com/api/projects/{project}/persons/?distinct_id=user%20distinct%20id",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "results.0.properties.is_cool",
          "equals": "true"
        }
      ]
    },
    {
      "name": "Capture page pageview",
