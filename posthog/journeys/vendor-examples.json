{
  "vendor": "posthog",
  "host": "us.posthog.com",
  "author": "Contributor 94",
  "about": "PostHog's published capture, person-property and identify examples replayed against one project, each read back through the events and persons APIs.",
  "steps": [
    {
      "name": "Bootstrap the example account: its project, project token and personal API key",
      "method": "POST",
      "path": "/_twin/app-credentials",
      "status": 201,
      "body": {},
      "capture": {
        "token": "project_token",
        "key": "personal_api_key",
        "project": "project_id"
      }
    },
    {
      "name": "captureEvents published answer",
      "method": "POST",
      "path": "https://us.i.posthog.com/i/v0/e/",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "api_key": "{token}",
        "event": "captureEvents accepted",
        "distinct_id": "route_captureEvents",
        "properties": {
          "route": "/i/v0/e/"
        }
      },
      "expect": [
        {
          "path": "status",
          "equals": "Ok"
        }
      ],
      "example": "captureEvents#200 application/json"
    },
    {
      "name": "Read route_captureEvents's events",
      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/events/?distinct_id=route_captureEvents&after=2000-01-01T00:00:00Z",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "results.0.event",
          "equals": "captureEvents accepted"
        },
        {
          "path": "results.0.properties.route",
          "equals": "/i/v0/e/"
        }
      ]
    },
    {
      "name": "captureEventsLegacy published answer",
      "method": "POST",
      "path": "https://us.i.posthog.com/e/",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "api_key": "{token}",
        "event": "captureEventsLegacy accepted",
        "distinct_id": "route_captureEventsLegacy",
        "properties": {
          "route": "/e/"
        }
      },
      "expect": [
        {
          "path": "status",
          "equals": "Ok"
        }
      ],
      "example": "captureEventsLegacy#200 application/json"
    },
    {
      "name": "Read route_captureEventsLegacy's events",
      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/events/?distinct_id=route_captureEventsLegacy&after=2000-01-01T00:00:00Z",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "results.0.event",
          "equals": "captureEventsLegacy accepted"
        },
        {
          "path": "results.0.properties.route",
          "equals": "/e/"
        }
      ]
    },
    {
      "name": "captureEvent published answer",
      "method": "POST",
      "path": "https://us.i.posthog.com/capture/",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "api_key": "{token}",
        "event": "captureEvent accepted",
        "distinct_id": "route_captureEvent",
        "properties": {
          "route": "/capture/"
        }
      },
      "expect": [
        {
          "path": "status",
          "equals": "Ok"
        }
      ],
      "example": "captureEvent#200 application/json"
    },
    {
      "name": "Read route_captureEvent's events",
      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/events/?distinct_id=route_captureEvent&after=2000-01-01T00:00:00Z",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "results.0.event",
          "equals": "captureEvent accepted"
        },
        {
          "path": "results.0.properties.route",
          "equals": "/capture/"
        }
      ]
    },
    {
      "name": "captureBatch published answer",
      "method": "POST",
      "path": "https://us.i.posthog.com/batch/",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "api_key": "{token}",
        "batch": [
          {
            "event": "captureBatch accepted",
            "distinct_id": "route_captureBatch",
            "properties": {
              "route": "/batch/"
            }
          }
        ]
      },
      "expect": [
        {
          "path": "status",
          "equals": "Ok"
        }
      ],
      "example": "captureBatch#200 application/json"
    },
    {
      "name": "Read route_captureBatch's events",
      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/events/?distinct_id=route_captureBatch&after=2000-01-01T00:00:00Z",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "results.0.event",
          "equals": "captureBatch accepted"
        },
        {
          "path": "results.0.properties.route",
          "equals": "/batch/"
        }
      ]
    },
    {
      "name": "Capture page single event",
      "method": "POST",
      "path": "https://us.i.posthog.com/i/v0/e/",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "event": "event name",
        "distinct_id": "user distinct id",
        "properties": {
          "account_type": "pro"
        },
        "timestamp": "2020-08-16T09:03:11.913767",
        "api_key": "{token}"
      },
      "example": "captureEvents#doc Capture page single event",
      "expect": [
        {
          "path": "status",
          "equals": "Ok"
        }
      ]
    },
    {
      "name": "The single event is kept with its properties",
      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/events/?distinct_id=user%20distinct%20id&event=event%20name&after=2000-01-01T00:00:00Z",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "results.0.properties.account_type",
          "equals": "pro"
        }
      ]
    },
    {
      "name": "Capture page anonymous event",
      "method": "POST",
      "path": "https://us.i.posthog.com/i/v0/e/",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "api_key": "{token}",
        "event": "event name",
        "distinct_id": "user distinct id",
        "properties": {
          "$process_person_profile": false
        },
        "timestamp": "2020-08-16T09:03:11.913767"
      },
      "example": "captureEvents#doc Capture page anonymous event",
      "expect": [
        {
          "path": "status",
          "equals": "Ok"
        }
      ]
    },
    {
      "name": "Both events named event name are kept, one personless",
      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/events/?distinct_id=user%20distinct%20id&event=event%20name&after=2000-01-01T00:00:00Z",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "results.1",
          "exists": true
        }
      ]
    },
    {
      "name": "Capture page batch events",
      "method": "POST",
      "path": "https://us.i.posthog.com/batch/",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "api_key": "{token}",
        "batch": [
          {
            "event": "batched_event_name_1",
            "properties": {
              "distinct_id": "user distinct id",
              "account_type": "pro"
            },
            "timestamp": "[optional timestamp in ISO 8601 format]"
          },
          {
            "event": "batched_event_name_2",
            "properties": {
              "distinct_id": "user distinct id",
              "account_type": "pro"
            }
          }
        ]
      },
      "example": "captureBatch#doc Capture page batch events",
      "expect": [
        {
          "path": "status",
          "equals": "Ok"
        }
      ]
    },
    {
      "name": "The batch's first event, its distinct id taken from properties",
      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/events/?distinct_id=user%20distinct%20id&event=batched_event_name_1&after=2000-01-01T00:00:00Z",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "results.0.properties.account_type",
          "equals": "pro"
        },
        {
          "path": "results.1",
          "exists": false
        }
      ]
    },
    {
      "name": "and its second",
      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/events/?distinct_id=user%20distinct%20id&event=batched_event_name_2&after=2000-01-01T00:00:00Z",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "results.0.properties.distinct_id",
          "equals": "user distinct id"
        },
        {
          "path": "results.1",
          "exists": false
        }
      ]
    },
    {
      "name": "Capture page historical migration",
      "method": "POST",
      "path": "https://us.i.posthog.com/batch/",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "api_key": "{token}",
        "historical_migration": true,
        "batch": [
          {
            "event": "batched_event_name",
            "properties": {
              "distinct_id": "user_id"
            },
            "timestamp": "2024-04-03T12:00:00Z"
          },
          {
            "event": "batched_event_name",
            "properties": {
              "distinct_id": "user_id"
            },
            "timestamp": "2024-04-03T12:00:00Z"
          }
        ]
      },
      "example": "captureBatch#doc Capture page historical migration",
      "expect": [
        {
          "path": "status",
          "equals": "Ok"
        }
      ]
    },
    {
      "name": "Both migrated events keep their 2024 timestamps",
      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/events/?distinct_id=user_id&after=2000-01-01T00:00:00Z",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "results.0.event",
          "equals": "batched_event_name"
        },
        {
          "path": "results.0.timestamp",
          "equals": "2024-04-03T12:00:00+00:00"
        },
        {
          "path": "results.1.event",
          "equals": "batched_event_name"
        }
      ]
    },
    {
      "name": "Capture page alias",
      "method": "POST",
      "path": "https://us.i.posthog.com/i/v0/e/",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "api_key": "{token}",
        "event": "$create_alias",
        "distinct_id": "123",
        "properties": {
          "alias": "456"
        }
      },
      "example": "captureEvents#doc Capture page alias",
      "expect": [
        {
          "path": "status",
          "equals": "Ok"
        }
      ]
    },
    {
      "name": "123 and 456 are one person",
      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/persons/?distinct_id=456",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "results.0.distinct_ids",
          "members": [
            "123",
            "456"
          ]
        }
      ]
    },
    {
      "name": "Capture page group identify",
      "method": "POST",
      "path": "https://us.i.posthog.com/i/v0/e/",
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "api_key": "{token}",
        "event": "$groupidentify",
        "distinct_id": "groups_setup_id",
        "properties": {
          "$group_type": "<group_type>",
          "$group_key": "<company_name>",
          "$group_set": {
            "name": "<company_name>",
            "subscription": "premium",
            "date_joined": "[optional timestamp in ISO 8601 format]"
