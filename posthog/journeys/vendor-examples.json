      "expect": [
        {
          "path": "status",
          "equals": "Ok"
        }
      ]
    },
    {
      "name": "The email is gone, the plan stays",
      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/persons/?distinct_id=distinct_id",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "results.0.properties.plan",
          "equals": "pro"
        },
        {
          "path": "results.0.properties.email",
          "exists": false
        },
        {
          "path": "results.0.properties.name",
          "equals": "Mr. Fox"
        }
