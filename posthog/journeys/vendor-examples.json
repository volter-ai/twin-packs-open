      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/events/?distinct_id=user%20distinct%20id&event=%24screen&after=2000-01-01T00:00:00Z",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
