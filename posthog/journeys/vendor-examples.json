    {
      "name": "Read groups_setup_id's events",
      "method": "GET",
      "path": "https://us.posthog.com/api/projects/{project}/events/?distinct_id=groups_setup_id&after=2000-01-01T00:00:00Z",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
