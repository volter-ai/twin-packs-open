{
  "name": "@volter/twin-stripe",
  "version": "3.0.4",
  "description": "Local Stripe customer, checkout and billing workflows with synthetic state and the real Stripe SDK. Supported operations and hosted-page limits are documented in the README.",
  "keywords": [
    "twin",
    "local",
    "mock",
    "mirror",
    "simulator",
    "fixtures",
    "testing",
    "sdk",
    "api",
    "localstack",
    "stripe",
    "payments"
  ],
  "author": "Volter (https://github.com/volter-ai)",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "journeys",
    "spec",
    "README.md",
    "LICENSE",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "dist",
    "generated"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/twin-packs-open.git",
    "directory": "stripe"
  },
