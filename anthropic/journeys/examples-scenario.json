{
  "handlers": [
    {
      "id": "search",
      "on": {
        "hasTool": "web_search"
      },
      "respond": {
        "serverTools": [
          {
            "name": "web_search",
            "input": {
              "query": "synthetic published-example query"
            },
            "results": [
              {
                "type": "web_search_result",
                "url": "https://news.example.test/synthetic-result",
                "title": "Synthetic search result",
                "encrypted_content": "twin-stub-search-content",
                "page_age": "1 day"
              }
            ]
          }
        ],
        "text": "[twin-stub] The synthetic search result is ready. No hosted search ran."
      }
    }
  ]
}
