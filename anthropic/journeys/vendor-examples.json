    {
      "name": "Client weather tool",
      "example": "messages_post#doc Client weather tool",
      "method": "POST",
      "path": "/v1/messages",
      "status": 200,
      "headers": {
        "x-api-key": "{key}",
        "anthropic-version": "2023-06-01",
        "content-type": "application/json"
      },
      "body": {
        "model": "claude-opus-5-5",
        "max_tokens": 1024,
        "tools": [
          {
            "name": "get_weather",
            "description": "Get the current weather for a given location.",
            "input_schema": {
              "type": "object",
              "properties": {
                "location": {
                  "type": "string",
                  "description": "City and state, e.g. San Francisco, CA"
                }
              },
              "required": [
                "location"
              ]
            }
          }
        ],
        "tool_choice": {
          "type": "auto",
          "disable_parallel_tool_use": true
        },
        "messages": [
          {
            "role": "user",
            "content": "What's the weather in San Francisco?"
          }
        ]
      },
      "expect": [
        {
          "path": "model",
          "equals": "claude-opus-5-5"
        },
        {
          "path": "content.0.name",
          "equals": "get_weather"
        },
        {
          "path": "stop_reason",
          "equals": "tool_use"
        },
        {
          "path": "role",
          "equals": "assistant"
        }
      ],
      "capture": {
        "tool": "content.0.id",
        "toolInput": "content.0.input"
      }
    },
    {
      "name": "Client weather tool continuation",
      "example": "messages_post#doc Client weather tool continuation",
      "method": "POST",
      "path": "/v1/messages",
      "status": 200,
      "headers": {
        "x-api-key": "{key}",
        "anthropic-version": "2023-06-01",
        "content-type": "application/json"
      },
      "body": {
        "model": "claude-opus-5-5",
        "max_tokens": 1024,
        "tools": [
          {
            "name": "get_weather",
            "description": "Get the current weather for a given location.",
            "input_schema": {
              "type": "object",
              "properties": {
                "location": {
                  "type": "string",
                  "description": "City and state, e.g. San Francisco, CA"
                }
              },
              "required": [
                "location"
              ]
            }
          }
        ],
        "tool_choice": {
          "type": "auto",
          "disable_parallel_tool_use": true
        },
        "messages": [
          {
            "role": "user",
            "content": "What's the weather in San Francisco?"
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "tool_use",
                "id": "{tool}",
                "name": "get_weather",
                "input": "{toolInput}"
              }
            ]
          },
          {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "{tool}",
                "content": "15 degrees Celsius, partly cloudy"
              }
            ]
          }
        ]
      },
      "expect": [
        {
          "path": "model",
          "equals": "claude-opus-5-5"
        },
        {
          "path": "content.0.type",
          "equals": "text"
        },
        {
          "path": "stop_reason",
          "equals": "end_turn"
        },
        {
          "path": "role",
          "equals": "assistant"
        }
      ]
    },
