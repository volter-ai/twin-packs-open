{
  "vendor": "anthropic",
  "author": "Contributor 67",
  "host": "api.anthropic.com",
  "about": "The vendor's published API reference samples, message fragments, streaming clients, client-tool continuation and server web-search requests. Synthetic scripts supply web-search results and preserve their vendor wire. The reference renderer's two contradictory sampling requests are replayed as the spec's documented 400 refusal, with unchanged inputs.",
  "steps": [
    {
      "name": "October 2026, after the examples' models were released",
      "wait": "393120m"
    },
    {
      "name": "The World supplies the workspace API key used by these client examples",
      "method": "POST",
      "path": "/_twin/api-keys",
      "status": 201,
      "body": {
        "email": "examples@northdesk.be",
        "organization": "Example workspace",
        "name": "examples"
      },
      "capture": {
        "key": "key"
      }
    },
    {
      "name": "Reference request and rendered response",
      "example": "messages_post#doc Reference request and rendered response",
      "method": "POST",
      "path": "/v1/messages",
      "status": 400,
      "headers": {
        "x-api-key": "{key}",
        "anthropic-version": "2023-06-01",
        "content-type": "application/json"
      },
      "body": {
        "max_tokens": 1024,
        "messages": [
          {
            "content": "Hello, world",
            "role": "user"
          }
        ],
        "model": "claude-opus-5",
        "stream": false,
        "system": [
          {
            "text": "Today's date is 2024-06-01.",
            "type": "text"
          }
        ],
        "temperature": 1,
        "thinking": {
          "type": "adaptive"
        },
        "tools": [
          {
            "input_schema": {
              "type": "object",
              "properties": {
                "location": "bar",
                "unit": "bar"
              },
              "required": [
                "location"
              ]
            },
            "name": "name"
          }
        ],
        "top_k": 5,
        "top_p": 0.7
      },
      "expect": [
        {
          "path": "error.type",
          "equals": "invalid_request_error"
        }
      ],
      "exampleDiffers": {
        "status": "The reference renderer shows a success with Opus 5 plus top_k:5/top_p:0.7, but spec:/components/schemas/CreateMessageParams/properties/top_k and top_p (and the beta equivalents) explicitly reject top_k and top_p below 0.99 with 400 on models released after Opus 4.6. The published input is retained; this response is its documented refusal."
      }
    },
