{
  "handlers": [
    {
      "id": "draft-result",
      "on": {
        "toolResultFor": "draft_email"
      },
      "respond": {
        "text": "The renewal follow-up draft is ready for review; no email has been sent."
      }
    },
    {
      "id": "account",
      "on": {
        "hasTool": "lookup_account",
        "lastMessageIsToolResult": false,
        "userTextIncludes": "seats"
      },
      "respond": {
        "toolUses": [
          {
            "name": "lookup_account",
            "input": {
              "name": "Veldhoven Retail"
            }
          }
        ]
      }
    },
    {
      "id": "draft",
      "on": {
        "hasTool": "draft_email",
        "lastMessageTextIncludes": "Draft a follow-up"
      },
      "respond": {
        "toolUses": [
          {
            "name": "draft_email",
            "input": {
              "to": "sales@veldhovenshop.nl",
              "subject": "Your March renewal"
            }
          }
        ]
      }
    },
    {
      "id": "account-result",
      "on": {
        "toolResultFor": "lookup_account"
      },
      "respond": {
        "text": "Veldhoven Retail has 42 seats and renews on 1 March."
      }
    },
    {
      "id": "filters",
      "on": {
        "userTextIncludes": "Clicks from Belgian mobile users"
      },
      "respond": {
        "text": "{\"filters\":[{\"key\":\"country\",\"value\":\"BE\"},{\"key\":\"device\",\"value\":\"mobile\"}]}"
      }
    },
    {
      "id": "refund",
      "on": {
        "modelEquals": "claude-sonnet-4-5",
        "anyTextIncludes": "refund policy"
      },
      "respond": {
        "thinking": "Consult the synthetic Northdesk policy before answering.",
        "text": "Retailers can request a refund within 14 days. Ask finance to approve annual-plan exceptions."
      }
    }
  ]
}
