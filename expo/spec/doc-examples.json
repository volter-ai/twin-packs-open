        "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
      ],
      "quote": "replace the placeholder push token with your own"
    }
  },
  {
    "title": "four recipients in order",
    "source": "https://docs.expo.dev/push-notifications/sending-notifications/",
    "operation": "pushSend",
    "request": {
      "method": "POST",
      "url": "https://exp.host/--/api/v2/push/send"
    },
    "input": [
      {
        "to": "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]",
        "sound": "default",
        "body": "Hello world!"
      },
      {
        "to": "ExponentPushToken[yyyyyyyyyyyyyyyyyyyyyy]",
        "badge": 1,
        "body": "You've got mail"
      },
      {
        "to": [
          "ExponentPushToken[zzzzzzzzzzzzzzzzzzzzzz]",
          "ExponentPushToken[aaaaaaaaaaaaaaaaaaaaaa]"
        ],
        "body": "Breaking news!"
      }
    ],
    "output": {
      "data": [
        {
          "status": "ok",
          "id": "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
        },
        {
          "status": "ok",
          "id": "YYYYYYYY-YYYY-YYYY-YYYY-YYYYYYYYYYYY"
        },
        {
          "status": "ok",
          "id": "ZZZZZZZZ-ZZZZ-ZZZZ-ZZZZ-ZZZZZZZZZZZZ"
        },
        {
          "status": "ok",
          "id": "AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA"
        }
      ]
    },
    "means": "Here's an example request body that sends four messages:",
    "status": 200,
    "placeholders": {
      "names": [
        "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]",
        "ExponentPushToken[yyyyyyyyyyyyyyyyyyyyyy]",
        "ExponentPushToken[zzzzzzzzzzzzzzzzzzzzzz]",
        "ExponentPushToken[aaaaaaaaaaaaaaaaaaaaaa]",
        "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX",
        "YYYYYYYY-YYYY-YYYY-YYYY-YYYYYYYYYYYY",
        "ZZZZZZZZ-ZZZZ-ZZZZ-ZZZZ-ZZZZZZZZZZZZ",
        "AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA"
      ],
      "quote": "replace the placeholder push token with your own"
    }
  },
  {
    "title": "individual ticket error",
    "source": "https://docs.expo.dev/push-notifications/sending-notifications/",
    "operation": "pushSend",
    "request": {
      "method": "POST",
      "url": "https://exp.host/--/api/v2/push/send"
    },
    "input": [
      {
        "to": "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]",
        "body": "Hello world!"
      },
      {
        "to": "ExponentPushToken[yyyyyyyyyyyyyyyyyyyyyy]",
        "body": "You've got mail"
      }
    ],
    "output": {
      "data": [
        {
          "status": "error",
          "message": "\"ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]\" is not a registered push notification recipient",
          "details": {
            "error": "DeviceNotRegistered"
          }
        },
        {
          "status": "ok",
          "id": "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
        }
      ]
    },
    "means": "If there were errors with individual messages, but not the entire request, the bad messages' corresponding push tickets will have a status of error",
    "status": 200,
    "placeholders": {
      "names": [
        "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]",
        "ExponentPushToken[yyyyyyyyyyyyyyyyyyyyyy]",
        "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
      ],
      "quote": "replace the placeholder push token with your own"
    }
  },
