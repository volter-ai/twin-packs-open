{
  "openapi": "3.0.3",
  "info": {
    "title": "Expo push notification service",
    "version": "2"
  },
  "servers": [
    {
      "url": "https://exp.host"
    }
  ],
  "paths": {
    "/--/api/v2/push/send": {
      "post": {
        "operationId": "pushSend",
        "summary": "Send push notifications: one message or an array of up to 100, answered with a push ticket for each recipient",
        "externalDocs": {
          "url": "https://docs.expo.dev/push-notifications/sending-notifications/"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "to"
                    ],
                    "properties": {
                      "to": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        ],
                        "description": "An Expo push token or an array of Expo push tokens specifying the recipient(s) of this message."
                      },
                      "_contentAvailable": {
                        "type": "boolean"
                      },
                      "data": {
                        "type": "object"
                      },
                      "title": {
                        "type": "string"
                      },
                      "body": {
                        "type": "string"
                      },
                      "ttl": {
                        "type": "integer"
                      },
                      "expiration": {
                        "type": "integer"
                      },
                      "priority": {
                        "type": "string",
                        "enum": [
                          "default",
                          "normal",
                          "high"
                        ]
                      },
                      "subtitle": {
                        "type": "string"
                      },
                      "sound": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          },
                          {
                            "type": "object"
                          }
                        ]
                      },
                      "badge": {
                        "type": "integer"
                      },
                      "interruptionLevel": {
                        "type": "string",
                        "enum": [
                          "active",
                          "critical",
                          "passive",
                          "time-sensitive"
                        ]
                      },
                      "channelId": {
                        "type": "string"
                      },
                      "icon": {
                        "type": "string"
                      },
                      "richContent": {
                        "type": "object"
                      },
                      "categoryId": {
                        "type": "string"
                      },
                      "mutableContent": {
                        "type": "boolean"
                      }
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "to"
                      ],
                      "properties": {
                        "to": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          ],
                          "description": "An Expo push token or an array of Expo push tokens specifying the recipient(s) of this message."
                        },
                        "_contentAvailable": {
                          "type": "boolean"
                        },
                        "data": {
                          "type": "object"
                        },
                        "title": {
                          "type": "string"
                        },
                        "body": {
                          "type": "string"
                        },
                        "ttl": {
                          "type": "integer"
                        },
                        "expiration": {
                          "type": "integer"
                        },
                        "priority": {
                          "type": "string",
                          "enum": [
                            "default",
                            "normal",
                            "high"
                          ]
                        },
                        "subtitle": {
                          "type": "string"
                        },
                        "sound": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            },
                            {
                              "type": "object"
                            }
                          ]
                        },
                        "badge": {
                          "type": "integer"
                        },
                        "interruptionLevel": {
                          "type": "string",
                          "enum": [
                            "active",
                            "critical",
                            "passive",
                            "time-sensitive"
                          ]
                        },
                        "channelId": {
                          "type": "string"
                        },
                        "icon": {
                          "type": "string"
                        },
                        "richContent": {
                          "type": "object"
                        },
                        "categoryId": {
                          "type": "string"
                        },
                        "mutableContent": {
                          "type": "boolean"
                        }
                      }
                    },
                    "maxItems": 100
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "push tickets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "ok",
                                "error"
                              ]
                            },
                            "id": {
                              "type": "string"
                            },
                            "message": {
                              "type": "string"
                            },
                            "details": {
                              "type": "object",
                              "properties": {
                                "error": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "status": {
                                "type": "string",
                                "enum": [
                                  "ok",
                                  "error"
                                ]
                              },
                              "id": {
                                "type": "string"
                              },
                              "message": {
                                "type": "string"
                              },
                              "details": {
                                "type": "object",
                                "properties": {
                                  "error": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      ]
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          },
                          "details": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "a request error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          },
                          "details": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/--/api/v2/push/getReceipts": {
      "post": {
        "operationId": "pushGetReceipts",
        "summary": "Get push receipts by ticket id: up to 1000",
        "externalDocs": {
          "url": "https://docs.expo.dev/push-notifications/sending-notifications/"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ids"
                ],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "push receipts by id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "ok",
                              "error"
                            ]
                          },
                          "id": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          },
                          "details": {
                            "type": "object",
                            "properties": {
                              "error": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          },
                          "details": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "a request error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          },
                          "details": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}