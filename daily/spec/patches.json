      "value": {
        "type": "string"
      },
      "why": "A recording object carries its room_name (the recordings overview's recording object: \"room_name\": \"test-recording-room\", https://docs.daily.co/reference/rest-api/recordings), and GET /recordings lists recording objects; Cal.com's dailyvideo app parses every listed recording with room_name required (packages/prisma/zod-utils.ts recordingItemSchema).",
      "source": {
        "url": "https://docs.daily.co/reference/rest-api/recordings",
        "quote": "A recording object represents a single saved recording."
      }
