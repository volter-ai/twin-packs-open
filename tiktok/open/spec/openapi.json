     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "post_info": {
          "type": "object",
          "properties": {
           "privacy_level": {
            "type": "string",
            "enum": [
             "PUBLIC_TO_EVERYONE",
             "MUTUAL_FOLLOW_FRIENDS",
             "FOLLOWER_OF_CREATOR",
             "SELF_ONLY"
            ]
           },
           "title": {
            "type": "string",
            "description": "The video caption; at most 2200 UTF-16 runes"
           },
           "description": {
            "type": "string"
           },
           "disable_duet": {
            "type": "boolean"
           },
           "disable_stitch": {
            "type": "boolean"
           },
           "disable_comment": {
            "type": "boolean"
           },
           "video_cover_timestamp_ms": {
            "type": "integer",
            "format": "int32"
           },
           "brand_content_toggle": {
            "type": "boolean"
           },
           "brand_organic_toggle": {
            "type": "boolean"
           },
           "is_aigc": {
            "type": "boolean"
           },
           "auto_add_music": {
            "type": "boolean"
           }
          }
         },
         "source_info": {
          "type": "object",
          "properties": {
           "source": {
            "type": "string",
            "enum": [
             "PULL_FROM_URL",
             "FILE_UPLOAD"
            ]
           },
           "video_url": {
            "type": "string"
           },
           "video_size": {
            "type": "integer",
            "format": "int64"
           },
           "chunk_size": {
            "type": "integer",
            "format": "int64"
           },
           "total_chunk_count": {
            "type": "integer",
            "format": "int64"
           },
           "photo_images": {
            "type": "array",
            "items": {
             "type": "string"
            },
            "maxItems": 35
           },
           "photo_cover_index": {
            "type": "integer",
            "format": "int32"
           }
          }
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "data": {
           "type": "object",
           "properties": {
            "publish_id": {
             "type": "string",
             "description": "An identifier to track the posting action; at most 64 characters"
            },
            "upload_url": {
             "type": "string",
             "description": "Where the video file is uploaded (FILE_UPLOAD); valid for one hour"
            }
           }
          },
          "error": {
           "$ref": "#/components/schemas/Error"
          }
         },
         "required": [
          "error"
         ]
        }
       }
      }
     },
     "401": {
      "description": "access_token_invalid or scope_not_authorized",
      "content": {
