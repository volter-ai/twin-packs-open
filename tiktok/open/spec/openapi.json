 "paths": {
  "/v2/oauth/token/": {
   "post": {
    "operationId": "oauthToken",
    "summary": "Fetch or refresh a user access token",
    "externalDocs": {
     "url": "https://developers.tiktok.com/doc/oauth-user-access-token-management"
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/x-www-form-urlencoded": {
       "schema": {
        "type": "object",
        "properties": {
         "client_key": {
          "type": "string"
         },
         "client_secret": {
          "type": "string"
         },
         "code": {
          "type": "string"
         },
         "grant_type": {
          "type": "string",
          "enum": [
           "authorization_code",
           "refresh_token"
          ]
         },
         "redirect_uri": {
          "type": "string"
         },
         "code_verifier": {
          "type": "string",
          "description": "Required for mobile and desktop app only"
         },
         "refresh_token": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "The tokens, or {error, error_description, log_id}",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "open_id": {
           "type": "string"
          },
          "scope": {
           "type": "string",
           "description": "A comma-separated list of the scopes the user has agreed to authorize"
          },
          "access_token": {
           "type": "string"
          },
          "expires_in": {
           "type": "integer",
           "format": "int64"
          },
          "refresh_token": {
           "type": "string"
          },
          "refresh_expires_in": {
           "type": "integer",
           "format": "int64"
          },
          "token_type": {
           "type": "string"
          },
          "error": {
           "type": "string"
          },
          "error_description": {
           "type": "string"
          },
          "log_id": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
