  "/video/": {
   "servers": [
    {
     "url": "https://open-upload.tiktokapis.com"
    }
   ],
   "put": {
    "operationId": "uploadVideo",
    "summary": "Send the video to TikTok servers (a chunk)",
    "externalDocs": {
     "url": "https://developers.tiktok.com/doc/content-posting-api-media-transfer-guide"
    },
    "parameters": [
     {
      "name": "upload_id",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "upload_token",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "Content-Range",
      "in": "header",
      "required": true,
      "schema": {
       "type": "string",
       "description": "bytes {FIRST_BYTE}-{LAST_BYTE}/{TOTAL_BYTE_LENGTH}"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "video/mp4": {
       "schema": {
        "type": "string",
        "format": "binary"
       }
      },
      "video/quicktime": {
       "schema": {
        "type": "string",
        "format": "binary"
       }
      },
      "video/webm": {
       "schema": {
        "type": "string",
        "format": "binary"
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "All parts are uploaded"
     },
     "206": {
      "description": "The current chunk has been successfully processed"
     },
     "400": {
      "description": "BadRequest"
     },
     "403": {
      "description": "The upload_url has expired"
     },
     "404": {
      "description": "No valid upload task given the upload_url"
     },
     "416": {
      "description": "Content-Range does not reflect the actual upload progress"
     }
    }
   }
  }
 },
