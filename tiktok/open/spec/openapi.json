  "/v2/post/publish/video/init/": {
   "post": {
    "operationId": "videoInit",
    "summary": "Direct Post: initialize the posting request",
    "externalDocs": {
     "url": "https://developers.tiktok.com/doc/content-posting-api-reference-direct-post"
    },
    "security": [
     {
      "bearer": []
     }
    ],
