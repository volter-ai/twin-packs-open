    "react-dom": "^19.2.7"
  },
  "peerDependencies": {
    "@volter/world-core": "^3.0.92"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@types/bun": "^1.2.20",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.3"
  }
}
