{
  "name": "@volter/twin-supabase",
  "version": "1.0.3",
  "description": "Local Supabase twin: a project's Postgres database, the World's own managed Postgres, whose URL the twin hands the application; the Management API, PostgREST, Storage and Auth answer the gap. Built on @volter/world-core.",
  "keywords": [
    "twin",
    "local",
    "mock",
    "mirror",
    "simulator",
    "fixtures",
    "testing",
    "sdk",
    "api",
    "localstack",
    "supabase",
    "postgres"
  ],
  "author": "Volter (https://github.com/volter-ai)",
  "license": "Apache-2.0",
  "files": [
    "src",
    "journeys",
    "spec",
    "auth",
    "rest",
    "storage",
    "README.md",
    "LICENSE",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "dist",
    "generated"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/twin-packs-open.git",
    "directory": "supabase"
  },
  "homepage": "https://github.com/volter-ai/twin-packs-open/tree/main/supabase#readme",
