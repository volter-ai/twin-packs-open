{
  "patches": [
    {
      "op": "add",
      "path": "/components/schemas/GetBroadcastResponseSuccess/properties/status/enum",
      "value": [
        "draft",
        "scheduled",
        "queued",
        "sent",
        "canceled"
      ],
      "why": "The spec types a broadcast's status as a bare string; Resend's Manage Broadcasts page lists every status a broadcast takes (draft, scheduled, sent, queued, canceled).",
      "source": {
        "url": "https://resend.com/docs/dashboard/broadcasts/manage-broadcasts",
        "quote": "Here are all the statuses that can be associated with a Broadcast"
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/Email/properties/scheduled_at",
      "value": {
        "type": [
          "string",
          "null"
        ],
        "description": "When the email is scheduled to be sent, or null."
      },
      "why": "Resend's Retrieve Email page answers an email with `scheduled_at` (null for one sent at once), which the spec's Email schema omits.",
      "source": {
        "url": "https://resend.com/docs/api-reference/emails/retrieve-email",
        "quote": "\"scheduled_at\": null"
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/Email/properties/tags",
      "value": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "description": "The tags the email was sent with."
      },
      "why": "Resend's Retrieve Email page answers an email with its `tags` (name and value), which the spec's Email schema omits.",
      "source": {
        "url": "https://resend.com/docs/api-reference/emails/retrieve-email",
        "quote": "\"tags\": ["
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/GetBroadcastResponseSuccess/properties/object",
      "value": {
        "type": "string",
        "description": "The type of object.",
        "example": "broadcast"
      },
      "why": "Resend's Retrieve Broadcast page answers a broadcast with `object: \"broadcast\"`, which the spec's schema omits.",
      "source": {
        "url": "https://resend.com/docs/api-reference/broadcasts/get-broadcast",
        "quote": "\"object\": \"broadcast\""
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/AddContactToSegmentResponseSuccess/properties/id",
      "value": {
        "type": "string",
        "description": "The ID of the segment the contact was added to."
      },
      "why": "Resend's Add Contact to Segment page answers the segment's id as `id`, which the spec's schema omits.",
      "source": {
        "url": "https://resend.com/docs/api-reference/contacts/add-contact-to-segment",
        "quote": "\"id\": \"78261eea-8f8b-4381-83c6-79fa7120f1cf\""
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/UpdateContactTopicsResponseSuccess/properties/id",
      "value": {
        "type": "string",
        "description": "The ID of the topic updated."
      },
      "why": "Resend's Update Contact Topics page answers the topic's id as `id`, which the spec's schema omits.",
      "source": {
        "url": "https://resend.com/docs/api-reference/contacts/update-contact-topics",
        "quote": "\"id\": \"b6d24b8e-af0b-4c3c-be0c-359bbd97381e\""
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/RemoveContactResponseSuccess/properties/contact",
      "value": {
        "type": "string",
        "description": "The ID of the deleted contact."
      },
      "why": "Resend's Delete Contact page names the deleted contact as `contact`, which the spec's schema omits.",
      "source": {
        "url": "https://resend.com/docs/api-reference/contacts/delete-contact",
        "quote": "\"contact\": \"520784e2-887d-4c25-b53c-4ad46ad38100\""
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/CreateApiKeyResponse/properties/object",
      "value": {
        "type": "string",
        "description": "The type of object.",
        "example": "api_key"
      },
      "why": "Resend's Create API key page answers `object: \"api_key\"`, which the spec's schema omits.",
      "source": {
        "url": "https://resend.com/docs/api-reference/api-keys/create-api-key",
        "quote": "\"object\": \"api_key\""
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/CreateSegmentResponseSuccess/properties/name",
      "value": {
        "type": "string",
        "description": "The name of the segment."
      },
      "why": "Resend's Create Segment page answers the segment's name, which the spec's schema omits.",
      "source": {
        "url": "https://resend.com/docs/api-reference/segments/create-segment",
        "quote": "\"name\": \"Registered Users\""
      }
    },
    {
      "op": "add",
      "path": "/paths/~1audiences~1{audience_id}~1contacts",
      "value": {
        "post": {
          "operationId": "audiences/create-contact",
          "summary": "Create a contact in an audience",
          "tags": [
            "Contacts"
          ],
          "parameters": [
            {
              "name": "audience_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "email"
                  ],
                  "properties": {
                    "email": {
                      "type": "string"
                    },
                    "first_name": {
                      "type": "string"
                    },
                    "last_name": {
                      "type": "string"
                    },
                    "unsubscribed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "object": {
                        "type": "string",
                        "example": "contact"
                      },
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "why": "The resend SDK (6.x, which Inbox Zero and Dub use) creates a contact in an audience at POST /audiences/{audience_id}/contacts when the call names an audienceId; Resend serves the path and its published document no longer lists it (audiences are deprecated for segments)",
      "source": {
        "url": "https://unpkg.com/resend@6.6.0/dist/index.mjs",
        "quote": "/audiences/${payload.audienceId}/contacts"
      }
    },
    {
      "op": "add",
      "path": "/paths/~1audiences~1{audience_id}~1contacts~1{id}",
      "value": {
        "delete": {
          "operationId": "audiences/remove-contact",
          "summary": "Remove a contact from an audience by its id or email",
          "tags": [
            "Contacts"
          ],
          "parameters": [
            {
              "name": "audience_id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            },
            {
              "name": "id",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "object": {
                        "type": "string",
                        "example": "contact"
                      },
                      "contact": {
                        "type": "string"
                      },
                      "deleted": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "why": "The resend SDK removes an audience's contact by id or email at DELETE /audiences/{audience_id}/contacts/{id_or_email} when the call names an audienceId (Inbox Zero's deleteContact)",
      "source": {
        "url": "https://unpkg.com/resend@6.6.0/dist/index.mjs",
        "quote": "/audiences/${payload.audienceId}/contacts/"
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/GetReceivedEmailResponse/properties/raw",
      "value": {
        "type": "object",
        "properties": {
          "download_url": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "why": "The Retrieve Received Email reference answers raw but the vendored schema omits it.",
      "source": {
        "url": "https://resend.com/docs/api-reference/emails/retrieve-received-email",
        "quote": "\"download_url\""
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/GetReceivedEmailResponse/properties/html_format",
      "value": {
        "type": "string",
        "description": "Format of the HTML body when returned inline."
      },
      "why": "The Retrieve Received Email reference answers html_format but the vendored schema omits it.",
      "source": {
        "url": "https://resend.com/docs/api-reference/emails/retrieve-received-email",
        "quote": "\"html_format\": \"data_uri\""
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/GetReceivedEmailResponse/properties/authentication",
      "value": {
        "type": "object",
        "properties": {
          "spf": {
            "type": "string"
          },
          "dkim": {
            "type": "string"
          },
          "dmarc": {
            "type": "string"
          }
        }
      },
      "why": "The Retrieve Received Email reference answers authentication but the vendored schema omits it.",
      "source": {
        "url": "https://resend.com/docs/api-reference/emails/retrieve-received-email",
        "quote": "\"authentication\""
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/GetReceivedEmailResponse/properties/attachments/items/properties/content_id/nullable",
      "value": true,
      "why": "The Retrieve Received Email reference explicitly returns null for the PDF attachment content_id; the vendored field omits nullable.",
      "source": {
        "url": "https://resend.com/docs/api-reference/emails/retrieve-received-email",
        "quote": "\"content_id\": null"
      }
    }
  ]
}
