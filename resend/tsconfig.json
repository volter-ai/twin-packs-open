{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "bun"
    ],
    "noEmit": true
  },
  "include": [
    "**/src/**/*.ts",
    "**/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
