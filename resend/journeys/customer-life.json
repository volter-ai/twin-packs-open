      "status": 201,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "name": "postiz-2",
        "team": "Kadewerk",
        "owner": "hanne@kadewerk.be"
      },
      "capture": {
        "k_postiz2": "token"
      }
    },
    {
      "name": "Postiz, with the new key, mails Nina",
      "method": "POST",
      "path": "https://api.resend.com/emails",
      "status": 200,
      "headers": {
        "authorization": "Bearer {k_postiz2}",
        "content-type": "application/json"
      },
      "body": {
        "from": "Kadewerk Social <social@mail.kadewerk.be>",
        "to": "nina@kadewerk.be",
        "subject": "Your post was published",
        "html": "<p>Published.</p>"
      }
    },
    {
      "name": "Monday 7 September: Dub's first program ends",
      "wait": "207450m"
    },
    {
      "name": "Dub removes its email domain",
      "method": "DELETE",
