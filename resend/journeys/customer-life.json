    {
      "name": "a minute later",
      "wait": "1m"
    },
    {
      "name": "The platform reads the team's sent mail back, newest first",
      "method": "GET",
      "path": "https://api.resend.com/emails?limit=2",
      "status": 200,
      "headers": {
        "authorization": "Bearer {k_worlds}",
        "content-type": "application/json"
      },
      "capture": {
        "second": "data.1.id"
      },
      "expect": [
        {
          "path": "object",
          "equals": "list"
        },
        {
          "path": "has_more",
          "equals": true
        },
        {
          "path": "data.0.id",
          "equals": "{added}"
        },
        {
          "path": "data.0.last_event",
          "equals": "delivered"
        },
        {
          "path": "data.0.html",
          "exists": false
        },
        {
          "path": "data.1.id",
          "equals": "{postiz1}"
        }
      ]
    },
    {
      "name": "and the page after it",
      "method": "GET",
      "path": "https://api.resend.com/emails?limit=2&after={second}",
      "status": 200,
      "headers": {
        "authorization": "Bearer {k_worlds}",
        "content-type": "application/json"
      },
      "expect": [
        {
          "path": "data.0.id",
          "exists": true
        },
        {
          "path": "data.0.id",
          "notContains": "{postiz1}"
        }
      ]
