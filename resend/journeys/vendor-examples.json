      "method": "POST",
      "path": "/_twin/inbound",
      "status": 201,
      "body": {
        "from": "onboarding@resend.dev",
        "to": [
          "forwarded@example.com"
        ],
        "subject": "Hello World",
        "html": "Congrats on sending your <strong>first email</strong>!",
        "authentication": {
          "spf": "pass",
          "dkim": "pass",
          "dmarc": "pass"
        },
        "headers": {
