        "capabilities": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture.",
        "data.0.capabilities": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture."
      }
