{
  "vendor": "resend",
  "host": "api.resend.com",
  "author": "Contributor 40",
  "about": "The published examples of the served email and domain operations; setup only establishes their preconditions or reads their effects. Reference request bodies are preserved, including the documented testing-domain refusal.",
  "steps": [
    {
      "name": "Setup: dashboard key for the owner, the delivered test address",
      "method": "POST",
      "path": "/_twin/api-keys",
      "status": 201,
      "body": {
        "name": "Examples",
        "team": "Examples",
        "owner": "delivered@resend.dev"
      },
      "headers": {
        "content-type": "application/json"
      },
      "capture": {
        "key": "token"
      }
    },
    {
      "name": "Send Email: the published testing-domain send",
      "method": "POST",
      "path": "/emails",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}",
        "content-type": "application/json"
      },
      "body": {
        "from": "Acme <onboarding@resend.dev>",
        "to": [
          "delivered@resend.dev"
        ],
        "subject": "hello world",
        "html": "<p>it works!</p>"
      },
      "capture": {
        "sent": "id"
      },
      "example": "emails/send#doc emails_send-email"
    },
    {
      "name": "Setup: delivery processing",
      "wait": "1m"
    },
    {
      "name": "Setup: read the send effect",
      "method": "GET",
      "path": "/emails/{sent}",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "id",
          "equals": "{sent}"
        },
        {
          "path": "from",
          "equals": "Acme <onboarding@resend.dev>"
        },
        {
          "path": "to",
          "equals": [
            "delivered@resend.dev"
          ]
        },
        {
          "path": "subject",
          "equals": "hello world"
        },
        {
          "path": "html",
          "equals": "<p>it works!</p>"
        },
        {
          "path": "last_event",
          "equals": "delivered"
        }
      ]
    },
    {
      "name": "Setup: the tagged email Retrieve Email reads",
      "method": "POST",
      "path": "/emails",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}",
        "content-type": "application/json"
      },
      "body": {
        "from": "Acme <onboarding@resend.dev>",
        "to": [
          "delivered@resend.dev"
        ],
        "subject": "Hello World",
        "html": "Congrats on sending your <strong>first email</strong>!",
        "tags": [
          {
            "name": "category",
            "value": "confirm_email"
          }
        ]
      },
      "capture": {
        "tagged": "id"
      }
    },
    {
      "name": "Setup: deliver the tagged email",
      "wait": "1m"
    },
    {
      "name": "Retrieve Email",
      "method": "GET",
      "path": "/emails/{tagged}",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "id",
          "equals": "{tagged}"
        },
        {
          "path": "from",
          "equals": "Acme <onboarding@resend.dev>"
        },
        {
          "path": "to",
          "equals": [
            "delivered@resend.dev"
          ]
        },
        {
          "path": "subject",
          "equals": "Hello World"
        },
        {
          "path": "html",
          "equals": "Congrats on sending your <strong>first email</strong>!"
        },
        {
          "path": "tags",
          "equals": [
            {
              "name": "category",
              "value": "confirm_email"
            }
          ]
        },
        {
          "path": "last_event",
          "equals": "delivered"
        },
        {
          "path": "created_at",
          "equals": "2026-01-01 00:01:00.000000+00"
        }
      ],
      "example": "emails/get#doc emails_retrieve-email",
      "undecided": {
        "text": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture.",
        "bcc": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture.",
        "cc": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture.",
        "reply_to": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture.",
        "scheduled_at": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture."
      }
    },
    {
      "name": "Send Batch Emails: the page sends to two non-owner addresses from the testing domain",
      "method": "POST",
      "path": "/emails/batch",
      "status": 403,
      "headers": {
        "authorization": "Bearer {key}",
        "content-type": "application/json"
      },
      "body": [
        {
          "from": "Acme <onboarding@resend.dev>",
          "to": [
            "foo@gmail.com"
          ],
          "subject": "hello world",
          "html": "<h1>it works!</h1>"
        },
        {
          "from": "Acme <onboarding@resend.dev>",
          "to": [
            "bar@outlook.com"
          ],
          "subject": "world hello",
          "html": "<p>it works!</p>"
        }
      ],
      "expect": [
        {
          "path": "name",
          "equals": "validation_error"
        }
      ],
      "example": "emails/send-batch#doc emails_send-batch-emails",
      "exampleDiffers": {
        "status": "The page uses onboarding@resend.dev to foo@gmail.com and bar@outlook.com. The documented testing-domain restriction permits only the account owner (https://resend.com/docs/api-reference/errors: You can only send testing emails to your own email address). This account owns delivered@resend.dev; the published request is therefore refused 403.",
        "data": "The documented validation_error refusal above carries no batch data."
      }
    },
    {
      "name": "Create Domain",
      "method": "POST",
      "path": "/domains",
      "status": 201,
      "headers": {
        "authorization": "Bearer {key}",
        "content-type": "application/json"
      },
      "body": {
        "name": "example.com"
      },
      "capture": {
        "domain": "id",
        "dkim": "records.0.value"
      },
      "expect": [
        {
          "path": "name",
          "equals": "example.com"
        },
        {
          "path": "status",
          "equals": "not_started"
        }
      ],
      "example": "domains/create#doc domains_create-domain",
      "undecided": {
        "region": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture.",
        "capabilities": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture."
      }
    },
    {
      "name": "Retrieve Domain: inspect the new domain",
      "method": "GET",
      "path": "/domains/{domain}",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "id",
          "equals": "{domain}"
        },
        {
          "path": "name",
          "equals": "example.com"
        },
        {
          "path": "status",
          "equals": "not_started"
        },
        {
          "path": "created_at",
          "equals": "2026-01-01 00:02:00.000000+00"
        },
        {
          "path": "records.0.value",
          "equals": "{dkim}"
        }
      ],
      "example": "domains/get#doc domains_get-domain",
      "exampleDiffers": {
        "records[].priority": "Retrieve Domain puts an SPF MX record first and assigns that MX priority 10; Create Domain puts DKIM TXT first and supplies no priority for TXT (spec/doc-examples.json, both reference pages). The schema does not require a record order; this domain keeps the Create Domain order, so the first DKIM TXT has no MX priority."
      },
      "undecided": {
        "region": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture.",
        "capabilities": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture.",
        "open_tracking": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture.",
        "click_tracking": "The request/setup does not supply this value; its representation is generated or defaulted by the vendor, rather than decided by this fixture."
      }
    },
    {
      "name": "Update Domain",
      "method": "PATCH",
      "path": "/domains/{domain}",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}",
        "content-type": "application/json"
      },
      "body": {
        "open_tracking": false,
        "click_tracking": true,
        "tracking_subdomain": "links",
        "tls": "enforced"
      },
      "expect": [
        {
          "path": "id",
          "equals": "{domain}"
        }
      ],
      "example": "domains/update#doc domains_update-domain"
    },
    {
      "name": "Setup: inspect the update effect",
      "method": "GET",
      "path": "/domains/{domain}",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "id",
          "equals": "{domain}"
        },
        {
          "path": "open_tracking",
          "equals": false
        },
        {
          "path": "click_tracking",
          "equals": true
        },
        {
          "path": "tracking_subdomain",
          "equals": "links"
        },
        {
          "path": "records.3.name",
          "equals": "links.example.com"
        }
      ]
    },
    {
      "name": "Setup: DNS resend._domainkey.example.com TXT",
      "method": "POST",
      "path": "/_twin/dns",
      "status": 201,
      "body": {
        "name": "resend._domainkey.example.com",
        "type": "TXT",
        "value": "{dkim}"
      },
      "headers": {
        "content-type": "application/json"
      }
    },
    {
      "name": "Setup: DNS send.example.com MX",
      "method": "POST",
      "path": "/_twin/dns",
      "status": 201,
      "body": {
        "name": "send.example.com",
        "type": "MX",
        "value": "feedback-smtp.us-east-1.amazonses.com"
      },
      "headers": {
        "content-type": "application/json"
      }
    },
    {
      "name": "Setup: DNS send.example.com TXT",
      "method": "POST",
      "path": "/_twin/dns",
      "status": 201,
      "body": {
        "name": "send.example.com",
        "type": "TXT",
        "value": "v=spf1 include:amazonses.com ~all"
      },
      "headers": {
        "content-type": "application/json"
      }
    },
    {
      "name": "Setup: DNS links.example.com CNAME",
      "method": "POST",
      "path": "/_twin/dns",
      "status": 201,
      "body": {
        "name": "links.example.com",
        "type": "CNAME",
        "value": "links1.resend-dns.com"
      },
      "headers": {
        "content-type": "application/json"
      }
    },
    {
      "name": "Verify Domain",
      "method": "POST",
      "path": "/domains/{domain}/verify",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "id",
          "equals": "{domain}"
        }
      ],
      "example": "domains/verify#doc domains_verify-domain"
    },
    {
      "name": "Setup: the verification effect is pending",
      "method": "GET",
      "path": "/domains/{domain}",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
        {
          "path": "id",
          "equals": "{domain}"
        },
        {
          "path": "status",
          "equals": "pending"
        }
      ]
    },
    {
      "name": "Setup: domain verification",
      "wait": "11m"
    },
    {
      "name": "List Domains",
      "method": "GET",
      "path": "/domains",
      "status": 200,
      "headers": {
        "authorization": "Bearer {key}"
      },
      "expect": [
