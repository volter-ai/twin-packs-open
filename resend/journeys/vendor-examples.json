          "path": "object",
          "equals": "list"
        },
        {
          "path": "has_more",
          "equals": false
        },
        {
          "path": "data.0.id",
          "equals": "{domain}"
        },
        {
          "path": "data.0.name",
          "equals": "example.com"
        },
        {
          "path": "data.0.status",
          "equals": "verified"
        },
        {
          "path": "data.0.open_tracking",
          "equals": false
        },
        {
          "path": "data.0.click_tracking",
          "equals": true
        },
        {
          "path": "data.0.created_at",
          "equals": "2026-01-01 00:02:00.000000+00"
        },
        {
          "path": "data.1",
          "exists": false
