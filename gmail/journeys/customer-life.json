          "contains": "8BITMIME"
        },
        {
          "path": "text",
          "contains": "SMTPUTF8"
        },
        {
          "path": "text",
          "notContains": "AUTH"
        },
        {
          "path": "text",
          "notContains": "STARTTLS"
        }
      ]
    },
    {
      "name": "MAIL FROM the poll's sender",
      "on": "g6",
      "send": "MAIL FROM:<polls@harbourline.be> BODY=8BITMIME",
      "status": 250,
      "expect": [
        {
          "path": "text",
          "equals": "2.1.0 OK - gsmtp"
        }
      ]
    },
    {
      "name": "RCPT TO Tom",
      "on": "g6",
      "send": "RCPT TO:<tom.brennan@gmail.com>",
      "status": 250,
      "expect": [
        {
          "path": "text",
          "equals": "2.1.5 OK - gsmtp"
        }
      ]
    },
    {
      "name": "DATA",
      "on": "g6",
      "send": "DATA",
      "status": 354,
      "expect": [
        {
          "path": "text",
          "equals": "Go ahead - gsmtp"
        }
      ]
    },
    {
      "name": "the reminder, then the dot",
      "on": "g6",
      "send": [
        "From: Harbourline Polls <polls@harbourline.be>",
        "To: tom.brennan@gmail.com",
        "Subject: Reminder: vote on the March workshop dates",
        "Date: Mon, 2 Mar 2026 09:00:00 +0000",
        "Message-ID: <wk3-reminder@meet.harbourline.be>",
        "MIME-Version: 1.0",
        "Content-Type: text/plain; charset=utf-8",
        "Content-Transfer-Encoding: 7bit",
        "",
        "You have not voted on the March workshop dates yet: https://meet.harbourline.be/invite/wk3",
        "."
      ],
      "status": 250,
      "expect": [
        {
          "path": "text",
          "equals": "2.0.0 OK - gsmtp"
        }
      ]
    },
    {
      "name": "QUIT",
      "on": "g6",
      "send": "QUIT",
      "status": 221,
      "expect": [
        {
          "path": "text",
          "equals": "2.0.0 closing connection - gsmtp"
        }
      ]
    },
    {
      "name": "Monday 2 March, 19:00: Tom reads his mail for the first time since January",
      "wait": "600m"
    },
    {
      "name": "Tom opens Gmail in a browser no Google account is signed in to: Gmail sends him to Google's sign-in, his inbox as the page to come back to",
      "method": "GET",
      "path": "https://mail.google.com/mail/u/0/",
      "status": 302,
      "expect": [
        {
          "path": "location",
          "contains": "https://accounts.google.com/ServiceLogin?"
        },
        {
          "path": "location",
          "contains": "service=mail"
        }
      ]
    },
    {
      "name": "Tom signs in with the address and password the account was made with, and is returned to the inbox",
      "method": "POST",
      "path": "https://accounts.google.com/ServiceLogin",
      "headers": {
        "content-type": "application/x-www-form-urlencoded"
      },
      "body": "email=tom.brennan%40gmail.com&password=Tom-Brennan-2026&continue=https%3A%2F%2Fmail.google.com%2Fmail%2Fu%2F0%2F",
      "status": 302,
      "expect": [
        {
          "path": "location",
          "equals": "https://mail.google.com/mail/u/0/"
        }
      ],
      "capture": {
        "tom_sid": "header:set-cookie:SID=([^;]+)"
      }
    },
    {
      "name": "His inbox, newest first: the reminder, then January's invitation; nothing of the mistyped address's",
      "method": "GET",
      "path": "https://mail.google.com/mail/u/0/",
      "headers": {
        "cookie": "SID={tom_sid}"
      },
      "status": 200,
      "expect": [
        {
          "path": "",
          "matches": "Reminder: vote on the March workshop dates.*Harbourline workshop: your date is set"
        },
        {
          "path": "",
          "notContains": "New comment on the February workshop poll"
        },
        {
          "path": "",
          "notContains": "Verify your new email address"
        }
      ],
      "capture": {
        "tom_reminder": "text:href=\"https://mail.google.com/mail/u/0/inbox/([^\"]+)\""
      }
    },
    {
      "name": "He opens the reminder",
      "method": "GET",
      "path": "https://mail.google.com/mail/u/0/inbox/{tom_reminder}",
      "headers": {
        "cookie": "SID={tom_sid}"
      },
      "status": 200,
      "expect": [
        {
          "path": "",
          "contains": "You have not voted on the March workshop dates yet"
        }
      ]
    },
    {
      "name": "Maya had shared the link to her copy of January's invitation; in Tom's mailbox it names nothing",
      "method": "GET",
      "path": "https://mail.google.com/mail/u/0/inbox/{maya_invite}",
      "headers": {
        "cookie": "SID={tom_sid}"
      },
      "status": 404,
      "expect": [
        {
          "path": "",
          "contains": "That message could not be found."
        }
      ]
    }
  ]
