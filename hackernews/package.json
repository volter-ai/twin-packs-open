{
  "name": "@volter/twin-hackernews",
  "version": "1.0.5",
  "description": "Hacker News twin: news.ycombinator.com as a person posts on it (login, submit a Show HN, comment, reply, upvote; the front page, newest, show and item pages) and its public Firebase read API, over one store. Built on @volter/world-core.",
  "author": "Volter (https://github.com/volter-ai)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "world-hackernews": "dist/src/cli.js"
  },
  "files": [
    "src",
    "journeys",
    "api",
    "site",
    "README.md",
    "LICENSE",
    "!**/*.test.ts",
    "dist",
    "generated"
  ],
  "peerDependencies": {
    "@volter/world-core": ">=3.0.163",
    "@volter/world-ui": ">=1.0.30",
    "@volter/world-runtime": ">=3.0.184"
  },
  "engines": {
    "node": ">=22.3"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/bun": "^1.2.20",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/twin-packs-open.git",
    "directory": "hackernews"
  },
  "homepage": "https://github.com/volter-ai/twin-packs-open/tree/main/hackernews#readme",
  "bugs": {
    "url": "https://github.com/volter-ai/twin-packs-open/issues"
  }
}
