{
  "patches": [
    {
      "op": "add",
      "path": "/paths/~1oauth~1access_token",
      "why": "The published v4 document omits the separately documented OAuth code exchange. Its operation server has no /v4 base.",
      "source": {
        "url": "https://dev.bitly.com/docs/getting-started/authentication/",
        "quote": "Use the /oauth/access_token API endpoint"
      },
      "value": {
        "post": {
          "operationId": "exchangeAccessToken",
          "summary": "Exchange an authorization code",
          "description": "Exchange the code, client credentials and the same redirect URI for an access token. The default response is form encoded; Accept application/json selects JSON.",
          "tags": [
            "OAuth"
          ],
          "servers": [
            {
              "url": "https://api-ssl.bitly.com"
            }
          ],
          "security": [],
          "requestBody": {
            "required": true,
            "content": {
              "application/x-www-form-urlencoded": {
                "schema": {
                  "type": "object",
                  "required": [
                    "client_id",
                    "client_secret",
                    "code",
                    "redirect_uri"
                  ],
                  "properties": {
                    "client_id": {
                      "type": "string"
                    },
                    "client_secret": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "redirect_uri": {
                      "type": "string"
                    },
                    "grant_type": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Access token and login",
              "content": {
                "application/x-www-form-urlencoded": {
                  "schema": {
                    "type": "string"
                  }
                },
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "access_token": {
                        "type": "string"
                      },
                      "login": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "400": {
              "description": "BAD_REQUEST",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/BadRequest"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
