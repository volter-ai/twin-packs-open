{
  "vendor": "merge",
  "author": "Contributor 65",
  "host": "api-gateway.merge.dev",
  "about": "Replay the published pagination requests and the documented validation, key, credit, stream and tool-choice contracts. Requests on models outside the demand-scoped catalogue are retained with reasons. Setup only supplies account credentials and the zero-credit precondition.",
  "steps": [
    {
      "name": "Replay at the current model-catalog date",
      "wait": "273d"
    },
    {
      "name": "Create the Pro organization whose key authenticates the documented requests",
      "method": "POST",
      "path": "/_twin/organizations",
      "body": {
        "name": "Documentation replay",
        "access": [
          "anthropic"
        ]
      },
      "status": 201,
      "capture": {
        "key": "api_key"
      }
    },
    {
      "name": "models_list#doc Pagination cURL first page",
      "example": "models_list#doc Pagination cURL first page",
      "method": "GET",
      "path": "/v1/models?limit=500",
      "status": 200,
      "headers": {
        "Authorization": "Bearer {key}",
        "Content-Type": "application/json"
      },
      "expect": [
        {
          "path": "object",
          "equals": "list"
        },
        {
          "path": "has_more",
          "equals": false
        },
        {
          "path": "data.0.model",
          "equals": "anthropic/claude-haiku-4-5-20251001"
        },
        {
          "path": "data.1.model",
          "equals": "anthropic/claude-sonnet-5-5"
        },
        {
          "path": "data.2.model",
          "equals": "zai/glm-5.3-flash"
        },
        {
          "path": "data.0.provider",
          "equals": "anthropic"
        },
        {
          "path": "data.1.provider",
          "equals": "anthropic"
        }
      ]
    },
    {
      "name": "models_list#doc Pagination cURL next page",
      "example": "models_list#doc Pagination cURL next page",
      "method": "GET",
      "path": "/v1/models?limit=500&cursor=mistral/magistral-medium-2509-thinking",
      "status": 200,
      "headers": {
        "Authorization": "Bearer {key}",
        "Content-Type": "application/json"
      },
      "expect": [
        {
          "path": "data.0.model",
          "equals": "anthropic/claude-haiku-4-5-20251001"
        },
        {
          "path": "data.1.model",
          "equals": "anthropic/claude-sonnet-5-5"
        },
        {
          "path": "data.2.model",
          "equals": "zai/glm-5.3-flash"
        },
        {
          "path": "data.0.provider",
          "equals": "anthropic"
        },
        {
          "path": "data.1.provider",
          "equals": "anthropic"
        }
      ],
      "undecided": {
        "data": "The documented stale cursor restarts the scoped catalogue; its contents are fixture models rather than the live catalog."
      }
    },
    {
      "name": "models_list#doc Pagination Python loop",
      "example": "models_list#doc Pagination Python loop",
      "method": "GET",
      "path": "/v1/models?limit=500",
      "status": 200,
      "headers": {
        "Authorization": "Bearer {key}",
        "Content-Type": "application/json"
      },
      "expect": [
        {
          "path": "has_more",
          "equals": false
        },
        {
          "path": "next_cursor",
          "exists": false
        },
        {
          "path": "data.0.provider",
          "equals": "anthropic"
        },
        {
          "path": "data.1.provider",
          "equals": "anthropic"
        }
      ]
    },
    {
      "name": "models_list#doc Oversized page refusal",
